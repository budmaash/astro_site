---
import '../styles/global.css';
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';

const htmlAttrs = {
  xmlnsOg: 'http://opengraphprotocol.org/schema/',
  xmlnsFb: 'http://www.facebook.com/2008/fbml',
  lang: 'en-US',
  class: 'no-js',
};

const {
  config = shellConfig,
  directionContract,
  noindex = false,
}: { config?: ShellConfig; directionContract?: string; noindex?: boolean } =
  Astro.props;

// Self-referencing canonical, always slash-less so /about and /about/ agree.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(canonicalPath, Astro.site ?? 'https://hasantutoring.com').href;
---
<!DOCTYPE html>
<html lang={htmlAttrs.lang} class={htmlAttrs.class} xmlns:og={htmlAttrs.xmlnsOg} xmlns:fb={htmlAttrs.xmlnsFb}>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{config.siteTitle}</title>
    <meta name="description" content={config.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/x-icon" href={config.favicon} />
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3f995c22-850b-4556-ade3-ce076f182e62"></script>
    <link rel="preconnect" href="https://images.squarespace-cdn.com/" />
    <link rel="preconnect" href="https://use.typekit.net/" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net/" crossorigin />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/user-account-core-deec763d109d5251-min.en-US.css" />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/website.components.code.styles.css" />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/website.components.html.styles.css" />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/website.components.button.styles.css" />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/site.css" />
    <link rel="stylesheet" type="text/css" href="/sqs-shell/static.css" />
    <link rel="stylesheet" type="text/css" href="/brand.css" />
  </head>
  <body id={config.bodyId} class={config.bodyClass}>
    {directionContract && <Fragment set:html={`<!-- ${directionContract} -->`} />}
    <slot />

    <!-- Scroll-to-top button, rendered on every page via this layout -->
    <button id="ht-scroll-top" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 18 18"
           fill="none" xmlns="http://www.w3.org/2000/svg"
           aria-hidden="true">
        <path d="M9 14V4M9 4L4 9M9 4L14 9"
              stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script is:inline>
      (function () {
        var scrollTopBtn = document.getElementById('ht-scroll-top');
        if (!scrollTopBtn) return;

        function updateScrollTopVisibility() {
          var scrolled = window.scrollY;
          var pageHeight = document.documentElement.scrollHeight;
          var viewportHeight = window.innerHeight;
          var halfwayPoint = (pageHeight - viewportHeight) / 2;

          if (scrolled >= halfwayPoint) {
            scrollTopBtn.classList.add('ht-scroll-top--visible');
          } else {
            scrollTopBtn.classList.remove('ht-scroll-top--visible');
          }
        }

        // Throttle scroll handler for performance
        var scrollTicking = false;
        window.addEventListener('scroll', function () {
          if (!scrollTicking) {
            window.requestAnimationFrame(function () {
              updateScrollTopVisibility();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        }, { passive: true });

        // Recalculate on resize
        window.addEventListener('resize', updateScrollTopVisibility, { passive: true });

        // Click handler for smooth scrolling to the top
        scrollTopBtn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Run once on load
        updateScrollTopVisibility();
      })();
    </script>
  </body>
</html>

<style is:global>
  #ht-scroll-top {
    /* Position — fixed, bottom-right */
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 200;

    /* Size & shape */
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);

    /* Colors */
    background: var(--color-surface);
    color: var(--color-text-dark);

    /* Layout */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    /* Shadow */
    box-shadow: var(--shadow-card-sm);

    /* Visibility — hidden by default */
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.5rem);
    transition: opacity 250ms ease,
                transform 250ms ease,
                background-color 150ms ease,
                border-color 150ms ease;
  }

  #ht-scroll-top.ht-scroll-top--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  #ht-scroll-top:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
  }
</style>
