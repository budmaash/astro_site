---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <!-- ======================================================
           SECTION 1 — HERO
           ====================================================== -->
      <section class="ht-about-hero">
        <div class="ht-about-hero__inner">
          <p class="ht-eyebrow ht-eyebrow--crimson">About Majid Hasan</p>
          <h1 class="ht-about-hero__h1">
            Tutor. Law graduate.<br>
            <em class="ht-about-hero__em">Kansas City native.</em>
          </h1>
          <p class="ht-about-hero__lead">
            Nearly 20 years helping students improve their ACT, SAT, and LSAT
            scores — one session at a time.
          </p>
        </div>
      </section>

      <!-- ======================================================
           SECTION 2 — BACKGROUND / BIOGRAPHY
           ====================================================== -->
      <section class="ht-about-bio">
        <div class="ht-about-bio__layout">

          <!-- LEFT: credentials sidebar -->
          <aside class="ht-about-bio__sidebar">
            <div class="ht-credential">
              <div class="ht-gold-rule" aria-hidden="true"></div>
              <p class="ht-credential__label">Started</p>
              <p class="ht-credential__value">2006 at Kaplan Test Prep</p>
            </div>
            <div class="ht-credential">
              <div class="ht-gold-rule" aria-hidden="true"></div>
              <p class="ht-credential__label">Education</p>
              <p class="ht-credential__value">KU School of Law</p>
            </div>
            <div class="ht-credential">
              <div class="ht-gold-rule" aria-hidden="true"></div>
              <p class="ht-credential__label">Location</p>
              <p class="ht-credential__value">Overland Park &amp; Kansas City</p>
            </div>
            <div class="ht-credential">
              <div class="ht-gold-rule" aria-hidden="true"></div>
              <p class="ht-credential__label">Clients</p>
              <p class="ht-credential__value">Built entirely by word of mouth</p>
            </div>
          </aside>

          <!-- RIGHT: bio prose -->
          <div class="ht-about-bio__prose">
            <p class="ht-eyebrow ht-eyebrow--gold">Background</p>
            <h2 class="ht-about-bio__h2">Nearly two decades of test-prep experience</h2>
            <p class="ht-about-bio__p">
              I started out teaching standardized tests in 2006 at Kaplan Test
              Prep — first the LSAT, then quickly moving on to the ACT and SAT.
              After finishing undergrad at KU, I moved back to Kansas City, my
              hometown, and began working at the Kauffman Foundation while also
              teaching at Get Smarter Prep in Overland Park.
            </p>
            <p class="ht-about-bio__p">
              During my second year of law school, I began tutoring on my own.
              Since then, I've built up a significant client base entirely
              through word of mouth — which I like to think reflects how
              satisfied students and their families are with the results.
            </p>
            <p class="ht-about-bio__p ht-about-bio__p--last">
              Chances are, if your child attends school in the Overland
              Park or Kansas City area, they already know classmates who've
              worked with me.
            </p>
          </div>

        </div>
      </section>

      <!-- ======================================================
           SECTION 3 — TEACHING PHILOSOPHY
           ====================================================== -->
      <section class="ht-about-philosophy">
        <div class="ht-about-philosophy__inner">
          <div class="ht-gold-rule ht-gold-rule--wide" aria-hidden="true"></div>
          <p class="ht-eyebrow ht-eyebrow--gold">Teaching philosophy</p>
          <h2 class="ht-about-philosophy__h2">These tests are learnable — by anyone</h2>
          <p class="ht-about-philosophy__p">
            The ACT and SAT should be taught differently than academic subjects.
            These tests are highly repetitive and highly coachable. Think of it
            like a physics professor who assigns the same homework every semester —
            only the numbers change. The approach to every question is identical.
            These tests work the same way. There are only so many question types.
            Learn to recognize them, learn the steps to answer each one, and
            your score improves.
          </p>
          <p class="ht-about-philosophy__p">
            I employ a very laid-back, no-pressure approach to both my teaching
            and my business. I assign a solid amount of work, but students
            generally enjoy working with me because I create an easy-going
            environment where mistakes are part of the process. I've always been
            good at explaining things in a way that anyone can understand.
          </p>
          <p class="ht-about-philosophy__p ht-about-philosophy__p--last">
            If you're interested in tutoring for your son or daughter, reach out
            anytime. I'll answer your questions, give you honest advice on how to
            proceed — whether that means working with me or not — and provide
            free practice exams to get started. No pressure, ever.
          </p>
        </div>
      </section>

      <!-- ======================================================
           SECTION 4 — CTA STRIP
           ====================================================== -->
      <section class="ht-cta-strip">
        <div class="ht-cta-strip__inner">
          <h2 class="ht-cta-strip__h2">Let's talk — no sales pitch, ever.</h2>
          <p class="ht-cta-strip__body">
            Call or email me anytime. I'm happy to answer questions, talk
            through your situation, and give you a free practice test to
            get a baseline score.
          </p>
          <div class="ht-cta-strip__btns">
            <a href="/contact" class="ht-btn ht-btn--white">Get in touch</a>
            <a href="tel:9132100611" class="ht-btn ht-btn--ghost">913.210.0611</a>
          </div>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>

  <script is:inline defer="true" src={config.siteBundle} type="text/javascript"></script>
  <div id="yui3-css-stamp" style="position: absolute !important; visibility: hidden !important"></div>
</SquarespaceShellLayout>

<style>
  /* ----------------------------------------------------------------
     Reset Squarespace container constraints on main
  ---------------------------------------------------------------- */
  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  /* ----------------------------------------------------------------
     Shared utilities
  ---------------------------------------------------------------- */
  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  .ht-eyebrow--gold {
    color: var(--color-accent-gold);
  }

  .ht-gold-rule {
    width: 2rem;
    height: 1px;
    background: var(--color-accent-gold);
    margin-bottom: 0.75rem;
  }

  .ht-gold-rule--wide {
    width: 2.5rem;
    margin-bottom: 1.5rem;
  }

  /* ----------------------------------------------------------------
     SECTION 1 — HERO
  ---------------------------------------------------------------- */
  .ht-about-hero {
    background: var(--color-surface);
    padding-top: clamp(12rem, 16vw, 15rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    padding-left: var(--space-section-h);
    padding-right: var(--space-section-h);
    text-align: center;
  }

  .ht-about-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-about-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text-dark);
    margin: 0 0 var(--space-6);
  }

  .ht-about-hero__em {
    font-style: italic;
    color: var(--color-muted);
  }

  .ht-about-hero__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 580px;
    margin: 0 auto;
  }

  /* ----------------------------------------------------------------
     SECTION 2 — BIOGRAPHY
  ---------------------------------------------------------------- */
  .ht-about-bio {
    background: var(--color-surface-warm);
    padding: clamp(3.5rem, 7vw, 6rem) var(--space-section-h);
  }

  .ht-about-bio__layout {
    display: flex;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: flex-start;
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  /* LEFT: credentials sidebar */
  .ht-about-bio__sidebar {
    flex: 0 0 220px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .ht-credential__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-muted);
    margin: 0 0 0.25rem;
  }

  .ht-credential__value {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text-dark);
    margin: 0;
  }

  /* RIGHT: bio prose */
  .ht-about-bio__prose {
    flex: 1;
  }

  .ht-about-bio__prose .ht-eyebrow {
    margin-bottom: 1rem;
  }

  .ht-about-bio__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .ht-about-bio__p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }

  .ht-about-bio__p--last {
    margin-bottom: 0;
  }

  /* ----------------------------------------------------------------
     SECTION 3 — TEACHING PHILOSOPHY
  ---------------------------------------------------------------- */
  .ht-about-philosophy {
    background: var(--color-surface);
    padding: clamp(3.5rem, 7vw, 6rem) var(--space-section-h);
  }

  .ht-about-philosophy__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-about-philosophy__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .ht-about-philosophy__p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }

  .ht-about-philosophy__p--last {
    margin-bottom: 0;
  }

  /* ----------------------------------------------------------------
     SECTION 4 — CTA STRIP
  ---------------------------------------------------------------- */
  .ht-cta-strip {
    background: var(--color-bg-dark);
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-h);
    text-align: center;
  }

  .ht-cta-strip__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .ht-cta-strip__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-light);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .ht-cta-strip__body {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.72);
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }

  .ht-cta-strip__btns {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ----------------------------------------------------------------
     Buttons
  ---------------------------------------------------------------- */
  .ht-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-button);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), opacity var(--transition-fast);
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
  }

  .ht-btn--white {
    background: var(--color-surface);
    color: var(--color-bg-dark);
    border: 1.5px solid transparent;
  }

  .ht-btn--white:hover {
    opacity: 0.9;
  }

  .ht-btn--ghost {
    background: transparent;
    color: var(--color-text-light);
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .ht-btn--ghost:hover {
    border-color: var(--color-text-light);
  }

  /* ----------------------------------------------------------------
     Responsive
  ---------------------------------------------------------------- */
  @media (max-width: 768px) {
    .ht-about-bio__layout {
      flex-direction: column;
    }

    .ht-about-bio__sidebar {
      flex: none;
      width: 100%;
    }
  }
</style>
