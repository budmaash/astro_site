---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import type { ShellConfig } from '../config/shell';
import { createShellConfig } from '../config/shell';
import { actServiceNode, actTutoringBreadcrumbNode } from '../config/schema';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';
import { longDate, nextActDate, upcomingActDates } from '../data/actTestDates';

// While the copy still has [bracketed] gaps, the page is noindex (which also
// drops its JSON-LD) and astro.config.mjs keeps it out of the sitemap. At
// launch, set this to false and remove the sitemap exclusion.
const DRAFT = true;

const defaultConfig = createShellConfig({
  siteTitle: 'ACT Tutoring & Prep in Kansas City | Hasan Tutoring',
  description:
    '1-on-1 ACT tutoring in Overland Park, Leawood and across Kansas City, MO & KS, or online. Prep for the new shorter ACT. Book a free consultation.',
  schema: [actServiceNode, actTutoringBreadcrumbNode],
});
const { config = defaultConfig }: { config?: ShellConfig } = Astro.props;

/** Split copy so [bracketed] gaps can be highlighted until they're filled. */
const segments = (text: string) => text.split(/(\[[^\]]+\])/).filter(Boolean);
const isGap = (segment: string) => segment.startsWith('[');

// Next test date and, once its deadlines close, the one after. Rebuild after
// each test so this moves on.
const upcoming = upcomingActDates();
const nextTest = upcoming[0];
const openDeadline = nextActDate();
const followingTest = upcoming[1];
const fullDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });

const steps = [
  {
    title: 'Start with a diagnostic.',
    body: 'Though not strictly necessary, I like to have students take a full ACT practice test (or at least the section or sections that we’re targeting). This allows me to see exactly which questions we’re missing and allows for full productivity from the first minute.',
  },
  {
    title: 'Get a plan built around the gaps.',
    body: "I map out what to work on, in what order, based on your student's target score, test date and the colleges or scholarships they're aiming for.",
  },
  {
    title: 'Weekly/biweekly one-on-one sessions.',
    body: 'Though it’s extremely flexible and tailor-made, we usually do 90-minute sessions focused on the questions your student actually misses, with targeted homework assignments between sessions. Progress is tracked from session to session.',
  },
  {
    title: 'Practice tests to track progress.',
    body: 'A full practice test halfway through prep and one right before test day.',
  },
];

const prices = [
  { label: 'One-on-one session', note: '90 minutes · $140 per hour', value: '$210' },
  { label: '8-session package', note: 'Eight 90-minute sessions · $187.50 per session', value: '$1,500' },
  { label: 'Consultation', value: 'Free' },
  { label: 'Materials', value: 'Included' },
];

// Hourly rates as Majid quoted them; keep them current or drop a row.
const competitorRates = [
  { name: 'Get Smarter Prep', note: 'tutors of comparable expertise', rate: '$400' },
  { name: 'Princeton Review', rate: '$390' },
  { name: 'Kaplan Test Prep', rate: '$200' },
];

const faqs = [
  {
    id: 'faq-cost',
    q: 'How much does ACT tutoring cost?',
    a: 'One-on-one sessions are $210 for 90 minutes ($140 per hour), or $1,500 for a package of eight 90-minute sessions. A consultation is free, and all materials are provided.',
  },
  {
    id: 'faq-sessions',
    q: 'How many sessions will my student need?',
    a: "It depends on the starting score, the target and the time until test day. Most of my students meet weekly or twice a week for 8–12 weeks; the diagnostic test tells us what's realistic before you commit.",
  },
  {
    id: 'faq-start',
    q: 'When should my student start?',
    a: 'Ideally two to three months before a test date. Many juniors take a national ACT in the fall or winter so the spring school-day test is a second try — Kansas pays for one ACT for every junior.',
  },
  {
    id: 'faq-science',
    q: 'Should my student take the Science section?',
    a: "Science is optional and doesn't count toward the composite score. Take it if a college or program on your student's list asks for it; otherwise skipping it shortens test day. I'll help you check each school's requirements.",
  },
  {
    id: 'faq-act-sat',
    q: 'ACT or SAT?',
    a: "Colleges accept either. Most students in Kansas and Missouri take the ACT, and Kansas juniors get a free school-day ACT. If you're unsure, a practice test of each shows which format suits your student — I tutor both.",
  },
  {
    id: 'faq-online',
    q: 'Do you tutor online?',
    a: 'Yes. Online sessions follow the same plan, with a shared whiteboard and the same practice tests.',
  },
];
---
<SquarespaceShellLayout config={config} noindex={DRAFT}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <!-- 1 — HERO -->
      <section class="ht-hub-hero" aria-labelledby="hub-title">
        <div class="ht-hub-hero__inner">
          <div class="ht-hub-hero__text">
            <p class="ht-eyebrow ht-eyebrow--crimson">1-on-1 ACT tutoring · Kansas City &amp; online</p>
            <h1 id="hub-title" class="ht-hub-hero__h1">ACT Tutoring and Prep in Kansas&nbsp;City</h1>
            <p class="ht-hub-hero__lead">
              One-on-one ACT tutoring from a test-prep expert with a long history
              of teaching the ACT, SAT, LSAT, GMAT and GRE to students in Overland
              Park, Leawood, and the greater Kansas City metro. Now in person on
              the Plaza, Kansas City, or online from anywhere in the world.
            </p>
            <div class="ht-hub-hero__actions">
              <a href="/contact" class="ht-btn ht-btn--primary">Book a free consultation</a>
            </div>
            <!-- Optional trust line, only with a real number: "Students who
                 finished a full program raised their ACT composite by an
                 average of [X] points." -->
          </div>
        </div>
      </section>

      <!-- 2 — HOW IT WORKS -->
      <section class="ht-hub-band ht-hub-band--warm" aria-labelledby="hub-how">
        <div class="ht-hub-band__inner ht-hub-band__inner--full">
          <header class="ht-hub-hdr">
            <h2 id="hub-how" class="ht-hub-hdr__h2">How ACT tutoring works</h2>
          </header>
          <ol class="ht-hub-steps">
            {steps.map((step, i) => (
              <li class="ht-hub-step">
                <span class="ht-hub-step__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ht-hub-step__h3">{step.title}</h3>
                <p class="ht-hub-step__p">
                  {segments(step.body).map((s) => (isGap(s) ? <span class="ht-todo">{s}</span> : s))}
                </p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 3 — WHERE WE MEET -->
      <section class="ht-hub-band" aria-labelledby="hub-where">
        <div class="ht-hub-band__inner">
          <header class="ht-hub-hdr">
            <h2 id="hub-where" class="ht-hub-hdr__h2">In person in Kansas City, or online</h2>
          </header>
          <p class="ht-hub-p ht-hub-p--lead">
            I meet students in person from all across the metro area, including
            Overland Park, Leawood, Olathe, Prairie Village, and Kansas City, MO.
            In-person tutoring is done here at my building on the Plaza
            (44 Washington, 551 W. 44th St.). We have conference rooms and
            workspaces where I meet with students regularly. I have students from
            a range of high schools in the area, including Pembroke, Shawnee
            Mission East, Rockhurst, St. Teresa’s, Barstow, many Blue Valley
            schools, and many others across the metro.
          </p>
          <p class="ht-hub-p ht-hub-p--lead">
            Online sessions run the same way, over Zoom with a shared whiteboard,
            so students anywhere in Kansas, Missouri or beyond get the same plan
            and the same practice tests.
          </p>
        </div>
      </section>

      <!-- 4 — PRICING -->
      <section id="pricing" class="ht-hub-band ht-hub-band--warm" aria-labelledby="hub-pricing">
        <div class="ht-hub-band__inner ht-hub-split ht-hub-pricing">
          <header class="ht-hub-hdr ht-hub-hdr--flush">
            <h2 id="hub-pricing" class="ht-hub-hdr__h2">Pricing</h2>
            <p class="ht-hub-hdr__lead">
              No long-term contracts needed. Pay per session with no commitments,
              or save with an 8-session package.
            </p>
          </header>
          <dl class="ht-hub-price">
            {prices.map((row) => (
              <div class="ht-hub-price__row">
                <dt>
                  {row.label}
                  {row.note && <span class="ht-hub-price__note">{row.note}</span>}
                </dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <div class="ht-hub-compare">
            <p class="ht-hub-compare__lead">An excellent deal at $140 per hour. Similar services are:</p>
            <dl class="ht-hub-compare__list">
              {competitorRates.map((row) => (
                <div class="ht-hub-compare__row">
                  <dt>
                    {row.name}
                    {row.note && <span class="ht-hub-compare__note">{row.note}</span>}
                  </dt>
                  <dd>{row.rate}<span class="ht-hub-compare__unit"> / hour</span></dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>

      <!-- 6 — TEASERS: each links to the page that covers the topic in full -->
      <section class="ht-hub-band" aria-label="The new ACT, scholarships, test dates and free videos">
        <div class="ht-hub-band__inner ht-hub-band__inner--full">
          <div class="ht-hub-teasers">

            <article class="ht-hub-teaser">
              <h2 class="ht-hub-teaser__h2">The ACT recently changed. Here’s what you need to know.</h2>
              <p class="ht-hub-p">
                Since 2025, the core ACT is English, Math and Reading — about
                two hours, with 44 fewer questions than before. Science is now
                optional, and your composite score comes from the three core
                sections only. Kansas and Missouri school-day testing switched
                to the new format in spring 2026. Everything I teach is built
                for the current test.
              </p>
              <!-- Point at /blog/enhanced-act once that post exists. -->
              <a class="ht-hub-teaser__link" href="/act-test-information">How the new ACT works →</a>
            </article>

            <article class="ht-hub-teaser">
              <h2 class="ht-hub-teaser__h2">Why your ACT score matters in Kansas and Missouri</h2>
              <ul class="ht-hub-teaser__list">
                <li>
                  <strong>Missouri's Bright Flight scholarship:</strong> an ACT
                  of 32 or higher qualifies for the top award, and 30–31 for the
                  second tier (2026 graduates). There's no application; the state
                  pulls scores directly.
                </li>
                <li>
                  <strong>Mizzou scholarships:</strong>
                  <ul class="ht-hub-teaser__sublist">
                    <li>
                      <strong>Perfect Score Scholarship:</strong> free tuition plus
                      approximately $20k in stipends and expenses.
                    </li>
                    <li>
                      <strong>Mizzou Scholars Award:</strong> $11,000 per year (up to
                      4 years), typically requires high academic metrics like an
                      ACT score of 33–36.
                    </li>
                    <li><strong>Chancellor’s Award:</strong> $7,200 per year, 30+ ACT.</li>
                    <li><strong>Curators Scholars Award:</strong> 26+ ACT.</li>
                  </ul>
                  Plus many more offers for both in-state and out-of-state
                  applicants.
                  <a href="https://admissions.missouri.edu/costs-aid/scholarships/freshman-scholarships/" target="_blank" rel="noopener">See Mizzou’s freshman scholarships</a>.
                </li>
                <li>
                  <strong>KU:</strong> test-optional, but a 21 or higher
                  guarantees admission for students below a 3.25 GPA, and the
                  School of Business uses an ACT-plus-GPA index for direct
                  admission.
                </li>
              </ul>
              <!-- Add "ACT scores and scholarships in Kansas and Missouri →"
                   linking to /blog/act-scholarships-ks-mo once that post
                   exists. Re-check Bright Flight cutoffs each fall. -->
            </article>

            <article class="ht-hub-teaser">
              {nextTest ? (
                <h2 class="ht-hub-teaser__h2">
                  Next ACT: <time datetime={nextTest[0]}>{fullDate(nextTest[0])}</time>
                </h2>
                <p class="ht-hub-p">
                  {openDeadline
                    ? <>{openDeadline.late ? 'Late registration' : 'Registration'} is open through <time datetime={openDeadline.deadline}>{longDate(openDeadline.deadline)}</time>.</>
                    : <>Registration has closed.</>}
                  {followingTest && (
                    <> After that, the next date is <time datetime={followingTest[0]}>{fullDate(followingTest[0]).replace(/^\w+, /, '')}</time> (register by <time datetime={followingTest[1]}>{longDate(followingTest[1])}</time>).</>
                  )}
                </p>
              ) : (
                <h2 class="ht-hub-teaser__h2">Upcoming ACT dates</h2>
                <p class="ht-hub-p">ACT hasn't published the next test dates yet.</p>
              )}
              <!-- Point at /act-test-dates once that page exists. -->
              <a class="ht-hub-teaser__link" href="/act-test-information">All 2026–27 ACT dates →</a>
            </article>

            <article class="ht-hub-teaser">
              <h2 class="ht-hub-teaser__h2">See how I teach before you book</h2>
              <p class="ht-hub-p">
                Every Math and English question on ACT Practice Test 2 has its
                own video explanation. Watch a few to see whether my approach
                clicks for your student.
              </p>
              <a class="ht-hub-teaser__link" href="/act_videos">Watch the ACT question explanations →</a>
            </article>

          </div>
        </div>
      </section>

      <!-- 7 — FAQ -->
      <section class="ht-hub-band ht-hub-band--warm" aria-labelledby="hub-faq">
        <div class="ht-hub-band__inner">
          <header class="ht-hub-hdr">
            <h2 id="hub-faq" class="ht-hub-hdr__h2">Frequently asked questions</h2>
          </header>
          <div class="ht-hub-faq">
            {faqs.map((faq) => (
              <div id={faq.id} class="ht-hub-faq__item">
                <h3 class="ht-hub-faq__q">{faq.q}</h3>
                <p class="ht-hub-faq__a">
                  {segments(faq.a).map((s) => (isGap(s) ? <span class="ht-todo">{s}</span> : s))}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 8 — FINAL CTA -->
      <section class="ht-hub-cta" aria-labelledby="hub-cta">
        <div class="ht-hub-cta__inner">
          <h2 id="hub-cta" class="ht-hub-cta__h2">Ready to start?</h2>
          <p class="ht-hub-cta__body">
            Book a free consultation. We'll talk through your student's goals,
            test date and starting point, and you'll leave with a recommended
            plan whether or not you book sessions.
          </p>
          <a href="/contact" class="ht-btn ht-btn--white">Book a free consultation</a>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>

  <div id="yui3-css-stamp" style="position: absolute !important; visibility: hidden !important"></div>
</SquarespaceShellLayout>

<style>
  /* ----------------------------------------------------------------
     Reset Squarespace container constraints on main
  ---------------------------------------------------------------- */
  /* Tighter than the site's --space-section-v (4–7rem). */
  .ht-main {
    --hub-section-v: clamp(2.75rem, 5vw, 4.5rem);
  }

  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  /* ----------------------------------------------------------------
     Shared utilities
  ---------------------------------------------------------------- */
  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  .ht-eyebrow--gold {
    color: var(--color-accent-gold);
  }

  /* Placeholder copy. Remove the spans as the real copy lands. */
  .ht-todo {
    background: var(--color-accent-gold-light);
    color: var(--color-text-dark);
    font-style: italic;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 0.2em;
  }

  .ht-hub-p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-5);
  }

  .ht-hub-p:last-child {
    margin-bottom: 0;
  }

  .ht-hub-p--lead {
    font-size: var(--text-md);
  }

  .ht-hub-p a,
  .ht-hub-teaser__list a {
    color: var(--color-text-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----------------------------------------------------------------
     Bands and section headers
  ---------------------------------------------------------------- */
  .ht-hub-band {
    background: var(--color-surface);
    padding: var(--hub-section-v) var(--space-section-h);
  }

  .ht-hub-band--warm {
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .ht-hub-band__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-hub-band__inner--full {
    max-width: var(--content-full);
  }

  .ht-hub-hdr {
    max-width: var(--content-max);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .ht-hub-hdr--flush {
    margin-bottom: 0;
  }

  .ht-hub-hdr__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-text-dark);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-5);
  }

  .ht-hub-hdr__h2:last-child {
    margin-bottom: 0;
  }

  .ht-hub-hdr__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-md);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Text beside a table or card. */
  .ht-hub-split {
    max-width: var(--content-full);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .ht-hub-split--center {
    align-items: center;
  }

  /* ----------------------------------------------------------------
     1 — HERO
  ---------------------------------------------------------------- */
  .ht-hub-hero {
    background: var(--color-surface);
    /* Same space below the resources banner as /practice-tests. */
    padding: clamp(3rem, 6vw, 5.75rem) var(--space-section-h) var(--hub-section-v);
  }

  .ht-hub-hero__inner {
    max-width: var(--content-full);
    margin: 0 auto;
  }

  .ht-hub-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-text-dark);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    margin: 0 0 var(--space-6);
  }

  .ht-hub-hero__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-md);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    max-width: 560px;
    margin: 0 0 var(--space-8);
  }

  .ht-hub-hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ----------------------------------------------------------------
     2 — HOW IT WORKS
  ---------------------------------------------------------------- */
  .ht-hub-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid var(--color-text-dark);
  }

  .ht-hub-step {
    padding: var(--space-6) clamp(1.25rem, 2.5vw, 2rem) 0;
    border-left: 1px solid var(--color-border-strong);
  }

  .ht-hub-step:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .ht-hub-step__num {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent-crimson);
    margin-bottom: var(--space-3);
  }

  .ht-hub-step__h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3);
  }

  .ht-hub-step__p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ----------------------------------------------------------------
     4 — PRICING
  ---------------------------------------------------------------- */
  .ht-hub-price {
    margin: 0;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--space-card-pad);
  }

  .ht-hub-price__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .ht-hub-price__row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .ht-hub-price__row:last-child {
    padding-bottom: 0;
  }

  .ht-hub-price__row dt {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .ht-hub-price__row dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    line-height: var(--leading-tight);
    text-align: right;
  }

  .ht-hub-price__note,
  .ht-hub-compare__note {
    display: block;
    margin-top: var(--space-1);
    font-weight: 400;
    color: var(--color-muted);
  }

  /* Desktop: heading and comparison on the left, price card on the right.
     Stacked, the card comes before the comparison. */
  .ht-hub-pricing {
    grid-template-rows: auto 1fr;
    row-gap: 0;
  }

  .ht-hub-pricing .ht-hub-price {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .ht-hub-compare {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-strong);
  }

  .ht-hub-compare__lead {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-hub-compare__list {
    margin: 0;
  }

  .ht-hub-compare__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-dark);
  }

  .ht-hub-compare__row:first-child {
    border-top: 0;
  }

  .ht-hub-compare__row dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }

