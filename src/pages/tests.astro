---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <!-- ======================================================
           SECTION 1 — HERO
           ====================================================== -->
      <section class="ht-tests-hero">
        <div class="ht-tests-hero__inner">
          <p class="ht-eyebrow ht-eyebrow--crimson">Test information</p>
          <h1 class="ht-tests-hero__h1">The ACT and the SAT</h1>
          <p class="ht-tests-hero__lead">
            Use this page to learn the basics of each exam — how they're
            structured, how timing and scoring work, and what topics each
            one covers.
          </p>
        </div>
      </section>

      <!-- ======================================================
           SECTION 2 — TWO TEST CARDS
           ====================================================== -->
      <section class="ht-tests-cards">
        <div class="ht-tests-cards__inner">

          <!-- ACT CARD -->
          <div class="ht-test-card">
            <span class="ht-tag">ACT</span>

            <h2 class="ht-test-card__h2">The ACT</h2>

            <p class="ht-test-card__intro">
              The ACT is one of two major college entrance exams. It has
              recently been updated, making each section shorter with fewer
              questions but more time per question. The exam is composed of four
              timed sections, each testing a distinct skill set.
            </p>

            <p class="ht-test-card__sections-label">Sections</p>

            <ul class="ht-styled-list">
              <li>
                <strong>English</strong> — Grammar, punctuation, and rhetorical
                understanding of composition. 50 questions, 35 minutes.
              </li>
              <li>
                <strong>Math</strong> — Algebra, geometry, trigonometry, and
                pre-calculus. More topics than the SAT but more straightforward
                question styles.
              </li>
              <li>
                <strong>Reading</strong> — Four long passages with specific
                detail and general understanding questions.
              </li>
              <li>
                <strong>Science</strong> (optional) — Data interpretation from
                charts and graphs. Requires virtually no science knowledge.
                Does not affect your composite score.
              </li>
              <li>
                <strong>Essay</strong> (optional) — 35-minute written response.
                Separate score, does not affect the 1–36 composite.
              </li>
            </ul>

            <a href="/act" class="ht-btn ht-btn--primary">Learn more about the ACT</a>
          </div><!-- /.ht-test-card -->

          <!-- SAT CARD -->
          <div class="ht-test-card">
            <span class="ht-tag">SAT</span>

            <h2 class="ht-test-card__h2">The SAT</h2>

            <p class="ht-test-card__intro">
              The SAT is the other major college entrance exam. As of 2024
              it is offered only in digital format. It consists of two scored
              areas — Reading/Writing and Math — each with a maximum of 800
              points, for a total possible score of 1600. Both sections use an
              adaptive two-module format.
            </p>

            <p class="ht-test-card__sections-label">Sections</p>

            <ul class="ht-styled-list">
              <li>
                <strong>Reading &amp; Writing</strong> — Two identical modules
                (27 questions, 32 minutes each). Tests vocabulary, logical
                reasoning, grammar, and synthesizing information. No long
                passages — each question has its own short paragraph.
              </li>
              <li>
                <strong>Math</strong> — Two identical modules (22 questions,
                35 minutes each). Covers algebra, geometry, and basic
                trigonometry. Fewer topics than the ACT but questions require
                higher analytical ability.
              </li>
            </ul>

            <a href="/sat" class="ht-btn ht-btn--primary">Learn more about the SAT</a>
          </div><!-- /.ht-test-card -->

        </div><!-- /.ht-tests-cards__inner -->
      </section>

      <!-- ======================================================
           SECTION 3 — BOTTOM CTA STRIP
           ====================================================== -->
      <section class="ht-cta-strip">
        <div class="ht-cta-strip__inner">
          <h2 class="ht-cta-strip__h2">Not sure which test to take?</h2>
          <p class="ht-cta-strip__body">
            I can provide free practice tests for both the ACT and SAT.
            Take both timed, compare your scores, and we'll go from there —
            no pressure, no sales pitch.
          </p>
          <div class="ht-cta-strip__btns">
            <a href="/act-vs-sat" class="ht-btn ht-btn--white">Compare ACT vs. SAT</a>
            <a href="/contact" class="ht-btn ht-btn--ghost">Get free practice tests</a>
          </div>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>

  <script is:inline defer="true" src={config.siteBundle} type="text/javascript"></script>
  <div id="yui3-css-stamp" style="position: absolute !important; visibility: hidden !important"></div>
</SquarespaceShellLayout>

<style>
  /* ----------------------------------------------------------------
     Reset Squarespace container constraints on main
  ---------------------------------------------------------------- */
  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  /* ----------------------------------------------------------------
     Shared utilities
  ---------------------------------------------------------------- */
  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  /* ----------------------------------------------------------------
     SECTION 1 — HERO
  ---------------------------------------------------------------- */
  .ht-tests-hero {
    background: var(--color-surface);
    padding-top: clamp(12rem, 16vw, 15rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    padding-left: var(--space-section-h);
    padding-right: var(--space-section-h);
    text-align: center;
  }

  .ht-tests-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-tests-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-5);
  }

  .ht-tests-hero__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* ----------------------------------------------------------------
     SECTION 2 — TEST CARDS
  ---------------------------------------------------------------- */
  .ht-tests-cards {
    background: var(--color-surface-warm);
    padding: clamp(3.5rem, 7vw, 6rem) var(--space-section-h);
  }

  .ht-tests-cards__inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  .ht-test-card {
    flex: 1 1 0%;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--space-card-pad);
    display: flex;
    flex-direction: column;
  }

  /* Tag pill */
  .ht-tag {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tag);
    padding: 0.3em 0.9em;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-muted);
    display: inline-block;
    margin-bottom: var(--space-5);
  }

  .ht-test-card__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .ht-test-card__intro {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .ht-test-card__sections-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  /* Styled list with gold dash bullets */
  .ht-styled-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-8);
    flex: 1;
  }

  .ht-styled-list li {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .ht-styled-list li:last-child {
    border-bottom: none;
  }

  .ht-styled-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.9em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent-gold);
  }

  /* CTA button */
  .ht-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-button);
    padding: 0.85em 1.75em;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast),
                border-color var(--transition-fast), opacity var(--transition-fast);
    border: none;
  }

  .ht-btn--primary {
    background: var(--color-accent);
    color: var(--color-text-light);
    align-self: flex-start;
  }

  .ht-btn--primary:hover {
    background: var(--color-accent-hover);
  }

  /* ----------------------------------------------------------------
     SECTION 3 — CTA STRIP
  ---------------------------------------------------------------- */
  .ht-cta-strip {
    background: var(--color-bg-dark);
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-h);
    text-align: center;
  }

  .ht-cta-strip__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .ht-cta-strip__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-light);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .ht-cta-strip__body {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.72);
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }

  .ht-cta-strip__btns {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ht-btn--white {
    background: var(--color-surface);
    color: var(--color-bg-dark);
    border: 1.5px solid transparent;
  }

  .ht-btn--white:hover {
    opacity: 0.9;
  }

  .ht-btn--ghost {
    background: transparent;
    color: var(--color-text-light);
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .ht-btn--ghost:hover {
    border-color: var(--color-text-light);
  }

  /* ----------------------------------------------------------------
     Responsive
  ---------------------------------------------------------------- */
  @media (max-width: 768px) {
    .ht-tests-cards__inner {
      flex-direction: column;
    }
  }
</style>
