---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';
import actLogo from '../assets/images/ACT_logo.webp';
import satLogo from '../assets/images/SAT_logo.png';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <!-- ======================================================
           SECTION 1 — HERO
           ====================================================== -->
      <section class="ht-tests-hero">
        <div class="ht-tests-hero__inner">
          <p class="ht-tests-hero__lead">
            <span>Use this page to learn the basics of each exam — how they're structured,</span>
            <span>how timing and scoring work, and what topics each one covers.</span>
          </p>
        </div>
      </section>

      <!-- ======================================================
           SECTION 2 — TWO TEST CARDS
           ====================================================== -->
      <section class="ht-tests-cards">
        <div class="ht-tests-cards__inner">

          <!-- ACT CARD -->
          <div class="ht-test-card">
            <div class="ht-test-card__heading">
              <h2 class="ht-test-card__h2">The ACT</h2>
              <img class="ht-test-card__logo" src={actLogo.src} alt="ACT" />
            </div>

            <p class="ht-test-card__intro">
              The ACT is one of two major college entrance exams. It has
              recently been updated, making each section shorter with fewer
              questions but more time per question. The exam is composed of four
              timed sections, each testing a distinct skill set.
            </p>

            <p class="ht-test-card__sections-label">Sections</p>

            <ul class="ht-styled-list">
              <li>
                The English section tests students' abilities to handle grammar
                and punctuation as well as deeper rhetorical and logical
                understanding of English composition.
              </li>
              <li>
                The Math section is a straightforward Math exam that tests
                topics ranging from basic Algebra, Geometry, Advanced Algebra,
                Trigonometry, and Pre-Calculus.
              </li>
              <li>
                The Reading section tests specific detail understanding as well
                as broader general reading understanding.
              </li>
              <li>
                Finally the Science section tests understanding of patterns and
                trends in data displayed primarily in charts and graphs. The
                Science section is now entirely optional! If you do decide to
                take the Science section, it will not affect your composite ACT
                score. Instead, you’ll receive a separate STEM score. It’s
                unclear whether colleges prefer, or even consider, your Science
                score. There is a separate Essay portion that is optional and
                costs an additional fee.
              </li>
            </ul>

            <a href="/act" class="ht-btn ht-btn--primary">Learn more about the ACT</a>
          </div><!-- /.ht-test-card -->

          <!-- SAT CARD -->
          <div class="ht-test-card">
            <div class="ht-test-card__heading">
              <h2 class="ht-test-card__h2">The SAT</h2>
              <img class="ht-test-card__logo" src={satLogo.src} alt="SAT" />
            </div>

            <p class="ht-test-card__intro">
              The SAT is the older, more-established college entrance exam,
              though no more accepted or regarded by colleges and universities.
              As of this year offered only digitally, it consists of two
              separate scores, first Reading and Writing and second, Math, each
              with a possible score of 800, for a total possible score of 1600.
              Each score is tested over two modules, both identical in their
              format and content. The second module of each section is adaptive
              and is based on your performance on the first module.
            </p>

            <p class="ht-test-card__sections-label">Sections</p>

            <ul class="ht-styled-list">
              <li>
                The Reading and Writing modules test vocabulary, rhetorical and
                logical reasoning, grammar and punctuation, and finally
                synthesizing information. There are no longer long reading
                passages with 10 or so questions. Instead, all Reading questions
                are one paragraph with one question each.
              </li>
              <li>
                The subject matter of the Math sections remains unchanged from
                previous iterations of the exam, covering algebra, geometry and
                basic trigonometry.
              </li>
            </ul>

            <a href="/sat" class="ht-btn ht-btn--primary">Learn more about the SAT</a>
          </div><!-- /.ht-test-card -->

        </div><!-- /.ht-tests-cards__inner -->
      </section>

      <!-- ======================================================
           SECTION 3 — BOTTOM CTA STRIP
           ====================================================== -->
      <section class="ht-cta-strip">
        <div class="ht-cta-strip__inner">
          <h2 class="ht-cta-strip__h2">Not sure which test to take?</h2>
          <p class="ht-cta-strip__body">
            I can provide free practice tests for both the ACT and SAT.
            Take both timed, compare your scores, and we'll go from there —
            no pressure, no sales pitch.
          </p>
          <div class="ht-cta-strip__btns">
            <a href="/act-vs-sat" class="ht-btn ht-btn--white">Compare ACT vs. SAT</a>
            <a href="/contact" class="ht-btn ht-btn--ghost">Get free practice tests</a>
          </div>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>

  <script is:inline defer="true" src={config.siteBundle} type="text/javascript"></script>
  <div id="yui3-css-stamp" style="position: absolute !important; visibility: hidden !important"></div>
</SquarespaceShellLayout>

<style>
  /* ----------------------------------------------------------------
     Reset Squarespace container constraints on main
  ---------------------------------------------------------------- */
  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  /* ----------------------------------------------------------------
     Shared utilities
  ---------------------------------------------------------------- */
  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  /* ----------------------------------------------------------------
     SECTION 1 — HERO
  ---------------------------------------------------------------- */
  .ht-tests-hero {
    background: var(--color-surface);
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
    padding-left: var(--space-section-h);
    padding-right: var(--space-section-h);
    text-align: center;
  }

  .ht-tests-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-tests-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-5);
  }

  .ht-tests-hero__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .ht-tests-hero__lead span {
    display: block;
  }

  /* ----------------------------------------------------------------
     SECTION 2 — TEST CARDS
  ---------------------------------------------------------------- */
  .ht-tests-cards {
    background: var(--color-surface-warm);
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--space-section-h)
             clamp(3.5rem, 7vw, 6rem);
  }

  .ht-tests-cards__inner {
    max-width: var(--content-full);
    margin: 0 auto;
    display: flex;
    gap: 0;
    align-items: stretch;
  }

  .ht-test-card {
    flex: 1 1 0%;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .ht-test-card:first-child {
    padding-right: clamp(2rem, 4vw, 4rem);
  }

  .ht-test-card + .ht-test-card {
    border-left: 3px solid #000;
    padding-left: clamp(2rem, 4vw, 4rem);
  }

  /* Tag pill */
  .ht-tag {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tag);
    padding: 0.3em 0.9em;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-muted);
    display: inline-block;
    margin-bottom: var(--space-5);
  }

  .ht-test-card__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
  }

  .ht-test-card__heading {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .ht-test-card__logo {
    width: 144px;
    height: 104px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .ht-test-card__intro {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .ht-test-card__sections-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  /* Styled list with gold dash bullets */
  .ht-styled-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-8);
    flex: 1;
  }

  .ht-styled-list li {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .ht-styled-list li:last-child {
    border-bottom: none;
  }

  .ht-styled-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.9em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent-gold);
  }

  /* CTA button */
  .ht-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-button);
    padding: 0.85em 1.75em;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast),
                border-color var(--transition-fast), opacity var(--transition-fast);
    border: none;
  }

  .ht-btn--primary {
    background: var(--color-accent);
    color: var(--color-text-light);
    align-self: flex-start;
  }

  .ht-btn--primary:hover {
    background: var(--color-accent-hover);
  }

  /* ----------------------------------------------------------------
     SECTION 3 — CTA STRIP
  ---------------------------------------------------------------- */
  .ht-cta-strip {
    background: var(--color-bg-dark);
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-h);
    text-align: center;
  }

  .ht-cta-strip__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .ht-cta-strip__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-light);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .ht-cta-strip__body {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.72);
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }

  .ht-cta-strip__btns {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ht-btn--white {
    background: var(--color-surface);
    color: var(--color-bg-dark);
    border: 1.5px solid transparent;
  }

  .ht-btn--white:hover {
    opacity: 0.9;
  }

  .ht-btn--ghost {
    background: transparent;
    color: var(--color-text-light);
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .ht-btn--ghost:hover {
    border-color: var(--color-text-light);
  }

  /* ----------------------------------------------------------------
     Responsive
  ---------------------------------------------------------------- */
  @media (max-width: 768px) {
    .ht-tests-cards__inner {
      flex-direction: column;
    }

    .ht-test-card:first-child {
      padding-right: 0;
      padding-bottom: var(--space-8);
    }

    .ht-test-card + .ht-test-card {
      border-left: 0;
      border-top: 3px solid #000;
      padding-top: var(--space-8);
      padding-left: 0;
    }
  }
</style>
