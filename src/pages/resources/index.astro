---
import SquarespaceFooter from '../../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../../components/SquarespaceHeader.astro';
import ResourcesBody from '../../components/ResourcesBody.astro';
import { createShellConfig } from '../../config/shell';
import { resourcesPageNodes } from '../../config/schema';
import { resources } from '../../data/resources';
import SquarespaceShellLayout from '../../layouts/SquarespaceShellLayout.astro';

const config = createShellConfig({
  siteTitle: 'ACT & SAT Test Prep Resources | Hasan Tutoring',
  description: 'Free ACT and SAT prep: an SAT vocabulary list, punctuation lessons, step-by-step math video explanations, and full-length practice tests. No sign-up.',
  schema: resourcesPageNodes(resources),
});
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />
    <div id="page" class="ht-resources-page">
      <ResourcesBody />
    </div>
    <SquarespaceFooter config={config} />
  </div>
</SquarespaceShellLayout>

<style is:global>
  #page.ht-resources-page {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>
