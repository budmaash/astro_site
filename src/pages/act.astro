---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <section class="ht-act-facts" aria-labelledby="act-facts-title">
        <div class="ht-act-facts__inner">
          <h1 id="act-facts-title" class="ht-act-facts__title">ACT Quick Facts</h1>

          <div class="ht-act-facts__grid">
            <section class="ht-act-facts__group">
              <h2 class="ht-act-facts__heading">Basics</h2>
              <dl class="ht-act-facts__list">
                <div>
                  <dt>ACT Length</dt>
                  <dd>2 hours and 5 minutes (125 minutes), plus 40 minutes for optional Science</dd>
                </div>
                <div>
                  <dt>Sections</dt>
                  <dd>3 sections: English, Math, and Reading; optional fourth section: Science</dd>
                </div>
                <div>
                  <dt>Score Range</dt>
                  <dd>Each section: 1–36; composite average: 1–36</dd>
                </div>
                <div>
                  <dt>Format</dt>
                  <dd>Paper or digital</dd>
                </div>
              </dl>
            </section>

            <section class="ht-act-facts__group">
              <h2 class="ht-act-facts__heading">Test Composition</h2>
              <dl class="ht-act-facts__list">
                <div class="ht-act-facts__timing"><dt>English</dt><dd>35 minutes for 50 questions</dd></div>
                <div class="ht-act-facts__timing"><dt>Math</dt><dd>50 minutes for 45 questions</dd></div>
                <div class="ht-act-facts__timing"><dt>Reading</dt><dd>40 minutes for 36 questions</dd></div>
                <div class="ht-act-facts__timing"><dt>Science (Optional)</dt><dd>40 minutes for 40 questions</dd></div>
                <div>
                  <dt>Math Topics</dt>
                  <dd>Pre-algebra, elementary and intermediate algebra, coordinate and plane geometry, and trigonometry</dd>
                </div>
                <div>
                  <dt>English Topics</dt>
                  <dd>Grammar and punctuation, rhetoric, writing style, and tone</dd>
                </div>
                <div>
                  <dt>Reading</dt>
                  <dd>4 long passages, specific information, and general themes</dd>
                </div>
              </dl>
            </section>

            <section class="ht-act-facts__group">
              <h2 class="ht-act-facts__heading">When It’s Offered</h2>
              <p class="ht-act-facts__months">
                February, April, June, July, September, October, and December
              </p>
              <a
                class="ht-act-facts__signup"
                href="https://my.act.org/"
                target="_blank"
                rel="noopener noreferrer"
              >Sign up or create an ACT account</a>
            </section>
          </div>
        </div>
      </section>

      <!-- ======================================================
           SECTION 2 — GUIDE BODY (sticky TOC + content)
           ====================================================== -->
      <section class="ht-act-guide">
        <div class="ht-act-guide__inner">

          <!-- LEFT — STICKY TABLE OF CONTENTS -->
          <nav class="ht-act-toc" aria-label="Page sections">
            <span class="ht-act-toc__heading">On this page</span>
            <ul class="ht-act-toc__list">
              <li class="ht-act-toc__item">
                <a href="/act#act-intro" class="ht-act-toc__link">1 — Introduction</a>
              </li>
              <li class="ht-act-toc__item">
                <a href="/act#act-english" class="ht-act-toc__link">2 — English</a>
              </li>
              <li class="ht-act-toc__item">
                <a href="/act#act-math" class="ht-act-toc__link">3 — Math</a>
              </li>
              <li class="ht-act-toc__item">
                <a href="/act#act-reading" class="ht-act-toc__link">4 — Reading</a>
              </li>
              <li class="ht-act-toc__item">
                <a href="/act#act-science" class="ht-act-toc__link">5 — Science</a>
              </li>
              <li class="ht-act-toc__item">
                <a href="/act#act-conclusion" class="ht-act-toc__link">6 — Conclusion</a>
              </li>
            </ul>
          </nav>

          <!-- RIGHT — GUIDE CONTENT -->
          <div class="ht-act-content">

            <!-- ── Section 1: Introduction ── -->
            <div id="act-intro" class="ht-act-section">
              <span class="ht-act-section__label">Introduction</span>
              <h2 class="ht-act-section__h2">The ACT is extremely learnable</h2>

              <p class="ht-act-section__p">
                I've been teaching the ACT since 2007, and if there's one thing
                I've learned, it's that the ACT is EXTREMELY learnable. This is
                because the test is extremely repetitive. The best, easiest way
                to improve your score is to learn the different types of questions,
                how to recognize them, and the steps to get to the right answer
                (you'll see this sentence a lot on this website). I teach students
                to turn the exam into a very mechanical process. You can become
                an ACT robot.
              </p>

              <p class="ht-act-section__p">
                The English section is one of the easiest test sections on either
                the ACT or the SAT. Over 35 minutes you must answer 50 questions
                (10 of which won't count) that can be categorized into one of two
                major categories: mechanics/usage and rhetoric. Mechanics and Usage
                questions cover topics such as subject-verb agreement, punctuation,
                apostrophes, pronouns, etc. The Rhetoric questions cover rhetorical
                issues: Relevant/Irrelevant information, sentence orders, paragraph
                orders, transition sentences and words, and occasionally word usage.
              </p>

              <p class="ht-act-section__p">
                The Math section covers quite a broad array of information.
                Fortunately, each topic is relatively narrow. So, for instance,
                all the trigonometry questions are limited to only 3 or so
                different types of questions. The Math section is extremely
                predictable, and this predictability is what I teach students
                to exploit. With some basic math review and strategy, anyone can
                see a huge improvement on this section.
              </p>

              <p class="ht-act-section__p">
                The Reading section is composed of four passages with 9 questions
                each. The topics and order are always the same: prose fiction,
                social sciences, humanities, and natural science. This is the one
                section that does not increase in order of difficulty. Though a
                very strong reading ability is required for an elite score, anyone
                can increase their score using my specific strategy that exploits
                the predictability of the section. There are only so many different
                types of questions; you can use this to your advantage.
              </p>

              <p class="ht-act-section__p">
                The Science section, now optional, is perhaps the one section that
                causes the most consternation among students. This section is
                extremely easy and requires virtually no science knowledge at all.
                It should be called the Common Sense section. There are only so
                many different types of questions here as well. I teach students
                to understand how the questions are composed and the simple
                underlying logic required throughout the exam. If you know what
                you're doing, this section is the simplest of the four. However,
                it won't affect your overall ACT score.
              </p>

              <p class="ht-act-section__p">
                Oh, and there's an optional essay as well, which also does not
                affect your 1–36 composite score. Instead, if you decide to take
                it, you'll receive an extra Writing score from 2–12 and a
                Writing/English combined score from 1–36.
              </p>
            </div><!-- /#act-intro -->

            <!-- ── Section 2: English ── -->
            <div id="act-english" class="ht-act-section">
              <span class="ht-act-section__label">Section 2</span>
              <h2 class="ht-act-section__h2">English</h2>

              <p class="ht-act-section__p">
                I've said it many times, and I'll say it again: the best way to
                improve on the English section is by learning the question types!
                There are only so many types of questions, and once you know them,
                you can easily learn the steps to get the right answer. Every time!
              </p>

              <h3 class="ht-act-section__subh">Usage &amp; Mechanics</h3>

              <p class="ht-act-section__p">
                Basically, these questions cover the grammar topics the English
                section tests. Punctuation questions can be broken down into two
                types: varied punctuation and comma-only punctuation. Each type
                has its own easy process you should use to get to the right answer.
                Additionally, you'll see questions related to apostrophes,
                subject-verb agreement, pronouns, who/whom, and a few other topics.
              </p>

              <p class="ht-act-section__p">
                The thing to remember is that this section is, by and large,
                quite straightforward. For instance, let's look at questions about
                subject-verb agreement. They can be split into two distinct types:
                plural vs. singular and past vs. present. Whenever you see a verb
                underlined on the English section, simply: 1. Find the subject.
                2. Check whether the verb is the appropriate singular or plural
                form. 3. If there are past and present forms among the answer
                choices, check the next or previous sentence to arrive at the
                correct form. It's as simple as a set of instructions. All these
                types of questions can be reduced in this manner.
              </p>

              <h3 class="ht-act-section__subh">Rhetoric</h3>

              <p class="ht-act-section__p">
                A VERY common type of question, VERY easily done. These questions
                cover rhetorical issues — they test whether you can recognize
                logical and cohesive writing. Questions will ask you about
                transition words, transition sentences, sentence relevancy,
                ordering (where to place a word within a sentence, a sentence
                within a paragraph, and a paragraph within an essay), active vs.
                passive voice, and sometimes word usage.
              </p>

              <p class="ht-act-section__p">
                Each of these question types can be as easily learned and
                mechanized as the usage/mechanics questions. For instance, if a
                question asks where to place a sentence within a paragraph, you
                only need to look for a logical gap between sentences. 'The little
                girl went to the mall. Fortunately, her brains were not eaten.'
                You can easily recognize that these two sentences don't belong
                next to each other. A question will ask where the sentence
                'Unfortunately, there was a zombie outbreak' should be placed.
                If you know you're looking for a logical gap, this question type
                — which is supposed to be challenging — becomes very simple. This
                is true of all types of rhetoric questions.
              </p>
            </div><!-- /#act-english -->

            <!-- ── Section 3: Math ── -->
            <div id="act-math" class="ht-act-section">
              <span class="ht-act-section__label">Section 3</span>
              <h2 class="ht-act-section__h2">Math</h2>

              <p class="ht-act-section__p">
                You need to know a lot of information to answer every question on
                the ACT Math section. Fortunately, most of the actual math you need
                you've already learned by the time you finish Algebra 2. The rest —
                which is not much — can easily be learned. What makes it manageable
                is that the breadth of each subject is very narrow on the ACT, so
                you don't need to learn the full scope. Trigonometry in school takes
                quite a while; you need to learn the theory of angles, trig
                functions, various Pythagorean identities, etc. On the ACT, however,
                there are only three types of trig questions: finding a missing side
                of a triangle, finding the value of a trig function on the unit
                circle, and what sine and cosine transformations look like on the
                coordinate plane. Each type is extremely repetitive — you can follow
                the same steps every time.
              </p>

              <h3 class="ht-act-section__subh">Math Topics</h3>

              <p class="ht-act-section__p">
                You need to know basic algebra, ratios, percentages, exponents,
                scientific notation, coordinate geometry, plane geometry (including
                various formulas), function notation, trigonometry, and a handful
                of infrequently tested topics: matrices, imaginary numbers,
                logarithms, and 3D spatial reasoning. These last topics usually
                appear as later, more difficult questions and are primarily used
                to limit the number of perfect scores.
              </p>

              <h3 class="ht-act-section__subh">Test-Taking Strategies</h3>

              <p class="ht-act-section__p">
                Good test takers learn how to get the right answer without doing
                the math — especially when they don't know how to do the math. The
                overarching philosophy is to always turn abstract problems into
                concrete ones. Often a question will ask you to manipulate
                quantities they never give you. 'Sarah increased her long jump
                distance by 20%, and then by 10%.' No initial distance is given.
                Here you can simply substitute your own number. Abstract to
                concrete.
              </p>

              <p class="ht-act-section__p">
                Many questions ask you to simplify an equation and find the
                equivalent answer. You can substitute a simple number in for the
                variable and turn the problem from one requiring advanced algebra
                into one that only requires basic arithmetic. When all answer
                choices are numbers listed in order, you can work backwards and
                plug in answer choices instead of solving the problem from scratch.
              </p>

              <p class="ht-act-section__p">
                Here's an example. For an exponents problem, one easy approach:
                when you raise exponents to a power, you multiply. If both terms
                end up with exponent 12 (3×4 and 4×3), the right answer must
                have 12 as an exponent. No further work needed. You've saved time
                and avoided mistakes by NOT fully expanding the problem. The
                fallback: set x=2, plug into the expression with your calculator,
                get the result, then plug x=2 into each answer choice until you
                find the match. Right answer, no algebra required.
              </p>
            </div><!-- /#act-math -->

            <!-- ── Section 4: Reading ── -->
            <div id="act-reading" class="ht-act-section">
              <span class="ht-act-section__label">Section 4</span>
              <h2 class="ht-act-section__h2">Reading</h2>

              <p class="ht-act-section__p">
                The reading section is for the most part straightforward, but
                very long and very boring. The length of the passages and the sheer
                amount of information in each one makes this section especially
                challenging. Furthermore, the way questions are composed —
                particularly the extremely tempting wrong answers — adds to the
                difficulty. However, if you learn how the section is composed and
                follow an innovative strategy designed to overcome these challenges,
                you can make this section simple.
              </p>

              <h3 class="ht-act-section__subh">Types of Questions</h3>

              <p class="ht-act-section__p">
                There are basically two major types of questions: those that ask
                about specific details in the passage, and those that ask about the
                passage overall. Each passage has 10 questions — 7 to 8 will be
                specific and only 2 to 3 will ask about the passage overall.
              </p>

              <p class="ht-act-section__p">
                Think about what the test wants you to do and why. They want you
                to read the passage first, then go to the questions. Because: 1.
                You'll spend a lot of time reading material that isn't even asked
                about. 2. Once you get to the questions, you'll have to go back
                and re-read, wasting even more time. Furthermore, many of the
                wrong answers come directly from the passage — but from irrelevant
                parts. This makes the test very confusing. However, if you can
                learn to answer the questions without reading the passage first,
                you can save precious time and avoid the most common wrong-answer
                traps.
              </p>

              <h3 class="ht-act-section__subh">Types of Wrong Answers</h3>

              <p class="ht-act-section__p">
                There are three major types of wrong answers. If you know them,
                and if you use my reading strategy, you can eliminate wrong answers
                far more easily. Some answers are completely irrelevant (but appear
                somewhere in the passage). Some are half right and half wrong. And
                some are completely wrong — but sound completely right. Fortunately,
                all three types are easy to learn to recognize. Using my reading
                strategy, knowledge of wrong answer types, and the process of
                elimination can get anyone significant increases on their results.
              </p>
            </div><!-- /#act-reading -->

            <!-- ── Section 5: Science ── -->
            <div id="act-science" class="ht-act-section">
              <span class="ht-act-section__label">Section 5</span>
              <h2 class="ht-act-section__h2">Science</h2>

              <p class="ht-act-section__p">
                The Science section might be the one that causes the most
                apprehension and confusion among students. What is it? What's on
                it? Have I taken enough science classes to do well?
              </p>

              <p class="ht-act-section__p">
                The reality is that this section has virtually nothing to do with
                actual science knowledge, and it is really, very, truly easy. It
                should simply be called the Common Sense section. All it tests is
                whether you can recognize patterns in graphs and tables, see how
                one variable changes as another does, and apply some basic reading
                comprehension inside of a science-flavored passage.
              </p>

              <h3 class="ht-act-section__subh">Increase / Decrease Questions</h3>

              <p class="ht-act-section__p">
                A good plurality of the Science section is composed of what I
                call Increase/Decrease questions. Essentially, they can be
                formulated like this: as X goes up (or down), what happens to Y?
                Or, as X changes, what other variable goes up? Questions will
                either ask this outright, or will require you to know this in
                order to answer a different question.
              </p>

              <h3 class="ht-act-section__subh">Chart &amp; Graph Analysis</h3>

              <p class="ht-act-section__p">
                Another major chunk of questions is based primarily on your
                ability to analyze graphs and charts. These questions are easy —
                they're simply made to sound difficult. One common tactic is to
                give you too much information. But if you understand that when
                they give you one point on one axis and ask for a point on another
                axis, all you need to do is trace up and over (or over and down,
                as the case may be). A harder version might ask for a point on one
                graph and require you to use it on a second graph — but even that
                follows easily learned steps. It's simply a matter of recognizing
                the question type and the simple steps to the right answer. This
                is true of almost every question on this exam.
              </p>
            </div><!-- /#act-science -->

            <!-- ── Section 6: Conclusion ── -->
            <div id="act-conclusion" class="ht-act-section ht-act-section--last">
              <span class="ht-act-section__label">Conclusion</span>
              <h2 class="ht-act-section__h2">Anyone can improve their score</h2>

              <p class="ht-act-section__p">
                As I'm sure you're incredibly tired of hearing by now, the ACT
                is all about question types. It's simply a matter of learning how
                to recognize them and the simple steps to get to the right answer.
                However, don't be fooled. There are some basic abilities a student
                must have before they can reach a certain level: basic math,
                reading, and critical thinking skills. Fortunately these skills
                are basic and can be learned well enough in a short amount of time
                to see major score increases.
              </p>

              <p class="ht-act-section__p">
                If you or your child is planning on taking the exam soon, the
                first thing you should do is see where you stand. Take a practice
                test — but make sure it's a REAL ACT. You can find five of them in
                The Real ACT book (link in my FAQs), or you can contact me for one
                for free. The more of these basic skills you have — particularly
                in math — the better along you already are, and the easier time
                you'll have learning the strategies that have been so successful
                for so many of my students.
              </p>

              <p class="ht-act-section__p">
                Two months is an ideal amount of time before the exam to begin
                preparation. One 1.5-hour session per week, with a good amount of
                homework and 2 or 3 full-length practice tests, is sufficient
                preparation for nearly anyone. For students already scoring very
                high (28 or 29+), beginning this early gives them sufficient time
                and the option to decrease meeting frequency once they reach their
                desired level.
              </p>

              <p class="ht-act-section__p">
                If there's anything I can leave you with, it's this: anyone can
                improve their scores. This test is learnable because of its
                repetitiveness. Learn how the test is composed and how to exploit
                it. Please give me a call, text, or email for answers to any
                questions you might have or for a free practice test. I'd love to
                help in any way I can.
              </p>

              <!-- CTA box -->
              <div class="ht-act-cta-box">
                <p class="ht-act-cta-box__p">
                  Ready to get started? I'll provide a free practice ACT,
                  answer any questions, and give you honest advice — whether
                  that means working with me or not.
                </p>
                <div class="ht-act-cta-box__links">
                  <a href="/contact" class="ht-btn ht-btn--primary">Get in touch</a>
                  <a href="/faq" class="ht-btn ht-btn--secondary">Read the FAQs</a>
                </div>
              </div>

            </div><!-- /#act-conclusion -->

          </div><!-- /.ht-act-content -->
        </div><!-- /.ht-act-guide__inner -->
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>

  <script is:inline defer="true" src={config.siteBundle} type="text/javascript"></script>
  <div id="yui3-css-stamp" style="position: absolute !important; visibility: hidden !important"></div>
</SquarespaceShellLayout>

<style>
  /* ----------------------------------------------------------------
     Smooth scroll & section offset for sticky header
  ---------------------------------------------------------------- */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* ----------------------------------------------------------------
     Reset Squarespace container constraints on main
  ---------------------------------------------------------------- */
  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  /* ----------------------------------------------------------------
     Shared utilities
  ---------------------------------------------------------------- */
  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  /* ----------------------------------------------------------------
     SECTION 1 — HERO
  ---------------------------------------------------------------- */
  .ht-act-hero {
    background: var(--color-surface);
    padding-top: clamp(12rem, 16vw, 15rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    padding-left: var(--space-section-h);
    padding-right: var(--space-section-h);
    text-align: center;
  }

  .ht-act-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-act-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-5);
  }

  .ht-act-hero__lead {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .ht-act-facts {
    padding: clamp(0.9rem, 1.8vw, 1.35rem) var(--space-section-h);
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .ht-act-facts__inner {
    max-width: var(--content-full);
    margin: 0 auto;
  }

  .ht-act-facts__title {
    margin: 0 0 0.45rem;
    color: var(--color-text-dark);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .ht-act-facts__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr 0.8fr;
    gap: 0;
    border-top: 2px solid var(--color-text-dark);
  }

  .ht-act-facts__group {
    padding: 1.35rem clamp(1.25rem, 2.5vw, 2.25rem) 0;
    border-left: 1px solid var(--color-border-strong);
  }

  .ht-act-facts__group:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .ht-act-facts__heading {
    margin: 0 0 1rem;
    color: var(--color-accent-crimson);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .ht-act-facts__list {
    margin: 0;
  }

  .ht-act-facts__list > div {
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-border);
  }

  .ht-act-facts__list > div:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .ht-act-facts__list > .ht-act-facts__timing {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.8fr) minmax(11rem, 1fr);
    column-gap: 1.25rem;
    align-items: baseline;
    text-align: left;
  }

  .ht-act-facts__timing dt,
  .ht-act-facts__timing dd {
    margin: 0;
    text-align: left;
  }

  .ht-act-facts__list dt {
    margin-bottom: 0.15rem;
    color: var(--color-text-dark);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .ht-act-facts__list dd,
  .ht-act-facts__months {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .ht-act-facts__signup {
    display: inline-block;
    margin-top: 1.25rem;
    padding-bottom: 0.2rem;
    color: var(--color-text-dark);
    border-bottom: 1px solid var(--color-accent-crimson);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-decoration: none;
    text-transform: uppercase;
