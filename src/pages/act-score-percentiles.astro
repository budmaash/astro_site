---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import { createShellConfig } from '../config/shell';
import { actPercentilesNode } from '../config/schema';
import {
  actPercentileColumns,
  actPercentileMeans,
  actPercentiles,
  actPercentilesSource,
} from '../data/actPercentiles';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';

const config = createShellConfig({
  siteTitle: 'ACT Score Percentiles: What Your ACT Score Means',
  description:
    'What ACT scores mean as percentile ranks, with the full table of national ranks for every ACT composite and section score, 1 to 36.',
  schema: [actPercentilesNode],
});

const dateModified = actPercentilesNode.dateModified as string;
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// [full name, short label shown on narrow screens]
const columnNames: Record<(typeof actPercentileColumns)[number], [string, string]> = {
  composite: ['Percentile', '%ile'],
  english: ['English', 'Eng'],
  math: ['Math', 'Math'],
  reading: ['Reading', 'Read'],
  science: ['Science', 'Sci'],
  stem: ['STEM', 'STEM'],
};
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />

    <main id="page" class="ht-main" tabindex="-1">

      <section class="ht-pct-hero">
        <div class="ht-pct-hero__inner">
          <p class="ht-eyebrow ht-eyebrow--crimson">ACT Scores</p>
          <h1 class="ht-pct-hero__h1">ACT Score Percentiles</h1>
          <p class="ht-pct-hero__byline">
            By <a href="/about">Majid Hasan</a>, ACT &amp; SAT tutor ·
            Updated <time datetime={dateModified}>{formatDate(dateModified)}</time>
          </p>
        </div>
      </section>

      <article class="ht-pct-body">
        <p>
          The ACT is one of two national standardized college entrance exams.
          Published and administered by ACT, Inc., the ACT is used by colleges
          and universities to determine eligibility for admission. But what do
          these scores mean? And what is a good score?
        </p>
        <p>
          Your ACT score corresponds to a percentile rank, which is used to
          compare you to all other test takers. Your percentile rank is the
          percentage of other test-takers that you scored above. Thus a 74th
          percentile score means that you scored higher than 74% of others,
          placing you in the top 26%. A 99th percentile score puts you in the
          top 1%.
        </p>
        <p>
          You can use this table to see what percentile an ACT score puts you
          in. For example, a composite score of 30 is approximately 95th
          percentile, and a 34 is the 99th percentile.
        </p>

        <figure class="ht-pct-figure">
          <h2 class="ht-pct-title" id="act-pct-caption">
            ACT percentile rank by score, {actPercentilesSource.reportingYear}
          </h2>
          <div class="ht-pct-scroll" tabindex="0" role="region" aria-labelledby="act-pct-caption">
            <table class="ht-pct-table" aria-labelledby="act-pct-caption">
              <thead>
                <tr>
                  <th scope="col">Score</th>
                  {actPercentileColumns.map((column) => (
                    <th scope="col" class={column === 'composite' ? 'is-composite' : undefined}>
                      <span class="ht-pct-long">{columnNames[column][0]}</span>
                      <span class="ht-pct-short" aria-hidden="true">{columnNames[column][1]}</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {actPercentiles.map((row) => (
                  <tr>
                    <th scope="row">{row.score}</th>
                    {actPercentileColumns.map((column) => (
                      <td class={column === 'composite' ? 'is-composite' : undefined}>{row[column]}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">Average</th>
                  {actPercentileColumns.map((column) => (
                    <td class={column === 'composite' ? 'is-composite' : undefined}>{actPercentileMeans[column]}</td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>
          <figcaption>
            Each number is the percentile rank for that score: the percent of
            test-takers who scored at or below it. These are the “US Rank”
            values on ACT score reports from September 2026 through August
            2027, based on ACT-tested high school graduates of
            {' '}{actPercentilesSource.graduatingClasses}. Source: ACT, Inc.
          </figcaption>
        </figure>

        <p>
          Of course, although your ACT (or SAT) score is a major factor
          colleges use to determine admission, there are many others,
          including GPA, the rigor of your high school courses, personal
          essays, letters of recommendation, etc.
        </p>
        <p>
          What is a good score? Well, whatever score gives you an excellent
          chance at admission to the schools you’re applying to (or gets you a
          great scholarship). Check out a few different examples of schools at
          different score ranges.
        </p>
      </article>

      <section class="ht-cta-strip">
        <h2 class="ht-cta-strip__h2">Want to raise your ACT score?</h2>
        <p class="ht-cta-strip__body">
          Every point moves you up the table. I'm happy to talk through where
          you are now and what it would take to reach your target.
        </p>
        <div class="ht-cta-strip__btns">
          <a href="/contact" class="ht-btn ht-btn--white">Get in touch</a>
          <a href="tel:9132100611" class="ht-btn ht-btn--ghost">913.210.0611</a>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>
</SquarespaceShellLayout>

<style>
  :global(#page.ht-main) {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  .ht-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-dark);
    margin: 0 0 var(--space-3);
  }

  .ht-eyebrow--crimson {
    color: var(--color-accent-crimson);
  }

  /* ----------------------------------------------------------------
     Hero
  ---------------------------------------------------------------- */
  .ht-pct-hero {
    background: var(--color-surface);
    padding: clamp(2rem, 3vw, 3rem) var(--space-section-h) var(--space-6);
    text-align: center;
  }

  .ht-pct-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .ht-pct-hero__h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-text-dark);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .ht-pct-hero__byline {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: var(--space-6) 0 0;
  }

  .ht-pct-hero__byline time {
    white-space: nowrap;
  }

  .ht-pct-hero__byline a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----------------------------------------------------------------
     Body copy
  ---------------------------------------------------------------- */
  .ht-pct-body {
    /* Matches the text column on /act and /sat. */
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-section-h) clamp(3rem, 6vw, 5rem);
    box-sizing: content-box;
  }

  .ht-pct-body > p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: var(--text-md);
    color: var(--color-text-dark);
    line-height: 1.8;
    margin: 0 0 var(--space-6);
  }

  .ht-pct-body > p:last-child {
    margin-bottom: 0;
  }

  /* ----------------------------------------------------------------
     Percentile table
  ---------------------------------------------------------------- */
  .ht-pct-figure {
    margin: var(--space-6) 0 clamp(2rem, 4vw, 3rem);
  }

  /* Shows the header plus 12 score rows; the rest scroll inside the box. */
  .ht-pct-scroll {
    --pct-head: 2.5rem;
    --pct-row: 2.25rem;
    max-height: calc(var(--pct-head) + 12 * var(--pct-row));
    overflow: auto;
    overscroll-behavior: contain;
    border-bottom: 1px solid var(--color-text-dark);
  }

  .ht-pct-scroll:focus-visible {
    outline: 2px solid var(--color-text-dark);
    outline-offset: 2px;
  }

  .ht-pct-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-dark);
    text-align: center;
  }

  .ht-pct-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    line-height: 1.2;
  }

  .ht-pct-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    box-sizing: border-box;
    height: var(--pct-head);
    padding: 0 0.4rem;
    background: var(--color-surface);
    /* A shadow rather than a border, so the line stays with the sticky header. */
    box-shadow: inset 0 -3px 0 var(--color-accent-crimson);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .ht-pct-table tbody th,
  .ht-pct-table tbody td,
  .ht-pct-table tfoot th,
  .ht-pct-table tfoot td {
    box-sizing: border-box;
    height: var(--pct-row);
    padding: 0 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .ht-pct-table tbody th,
  .ht-pct-table tfoot th {
    font-weight: 700;
  }

  .ht-pct-table tbody td {
    font-weight: 300;
  }

  .ht-pct-table tbody tr:nth-child(even) {
    background: var(--color-surface-warm);
  }

  .ht-pct-table th.is-composite,
  .ht-pct-table td.is-composite {
    color: var(--color-accent-crimson);
  }

  .ht-pct-table td.is-composite {
    font-weight: 700;
  }

  .ht-pct-table tfoot th,
  .ht-pct-table tfoot td {
    border-top: 2px solid var(--color-text-dark);
    border-bottom: 0;
  }

  .ht-pct-short {
    display: none;
  }

  @media (max-width: 640px) {
    .ht-pct-table thead th {
      padding-inline: 0.15rem;
      letter-spacing: 0.02em;
    }

    .ht-pct-table tbody th,
    .ht-pct-table tbody td,
    .ht-pct-table tfoot th,
    .ht-pct-table tfoot td {
      padding-inline: 0.15rem;
    }

    .ht-pct-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .ht-pct-short {
      display: inline;
    }
  }

  .ht-pct-figure figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* ----------------------------------------------------------------
     Buttons + CTA strip
  ---------------------------------------------------------------- */
  .ht-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-button);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), opacity var(--transition-fast);
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
  }

  .ht-btn--white {
    background: var(--color-surface);
    color: var(--color-bg-dark);
    border: 1.5px solid transparent;
  }

  .ht-btn--white:hover {
    opacity: 0.9;
  }

  .ht-btn--ghost {
    background: transparent;
    color: var(--color-text-light);
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .ht-btn--ghost:hover {
    border-color: var(--color-text-light);
  }

  .ht-cta-strip {
    background: var(--color-bg-dark);
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-h);
    text-align: center;
  }

  .ht-cta-strip__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-light);
    margin: 0 0 var(--space-6);
    line-height: var(--leading-snug);
  }

  .ht-cta-strip__body {
    font-family: var(--font-sans);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.72);
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }

  .ht-cta-strip__btns {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
