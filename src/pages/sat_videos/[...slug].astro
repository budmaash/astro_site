---
import SquarespaceFooter from '../../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../../components/SquarespaceHeader.astro';
import CoursebookVideoPage from '../../components/CoursebookVideoPage.astro';
import { videoLessons, satVideoHub } from '../../data/videoLessons';
import type { VideoLesson } from '../../data/videoLessons';
import { createShellConfig } from '../../config/shell';
import { videoPageNodes } from '../../config/schema';
import SquarespaceShellLayout from '../../layouts/SquarespaceShellLayout.astro';

// One page per video at its `path`, e.g. /sat_videos/test-8/module-1/question-20.
export function getStaticPaths() {
  return videoLessons.map((video) => ({
    params: { slug: video.path.slice(satVideoHub.path.length + 1) },
    props: { video },
  }));
}

const { video } = Astro.props as { video: VideoLesson };
const config = createShellConfig({
  siteTitle: video.pageTitle,
  description: video.metaDescription,
  schema: videoPageNodes(video, satVideoHub),
});
---
<SquarespaceShellLayout config={config}>
  <div id="siteWrapper" class="clearfix site-wrapper">
    <SquarespaceHeader config={config} />
    <CoursebookVideoPage videos={videoLessons} contentsLabel={satVideoHub.contentsLabel} hub={satVideoHub} current={video} />
    <SquarespaceFooter config={config} />
  </div>
</SquarespaceShellLayout>
