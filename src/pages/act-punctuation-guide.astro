  <script is:inline>
    (function () {
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('[data-nav-link]'));
      if (!navLinks.length) return;

      function getLinkId(link) {
        return new URL(link.getAttribute('href'), window.location.href).hash.slice(1);
      }

      function getScrollOffset() {
        var header = document.getElementById('header');
        return (header ? header.getBoundingClientRect().height : 0) + 24;
      }

      function updateScrollOffset() {
        document.documentElement.style.setProperty('--lesson-scroll-offset', getScrollOffset() + 'px');
      }

      var navigationRun = 0;

      function alignTarget(target, behavior) {
        var delta = target.getBoundingClientRect().top - getScrollOffset();
        if (Math.abs(delta) > 2) {
          window.scrollBy({ top: delta, behavior: behavior || 'auto' });
        }
      }

      function settleOnTarget(target, run) {
        [350, 800, 1400, 2200].forEach(function (delay) {
          window.setTimeout(function () {
            if (run === navigationRun) alignTarget(target, 'auto');
          }, delay);
        });
      }

      function cancelPendingAlignment() {
        navigationRun += 1;
      }

      window.addEventListener('wheel', cancelPendingAlignment, { passive: true });
      window.addEventListener('touchstart', cancelPendingAlignment, { passive: true });

      var sections = navLinks
        .map(function (link) {
          var id = getLinkId(link);
          return document.getElementById(id);
        })
        .filter(Boolean);

      function setActive(id) {
        navLinks.forEach(function (link) {
          link.classList.toggle('is-active', getLinkId(link) === id);
        });
      }

      updateScrollOffset();
      window.addEventListener('resize', updateScrollOffset, { passive: true });

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                setActive(entry.target.id);
              }
            });
          },
          { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
        );

        sections.forEach(function (section) {
          observer.observe(section);
        });
      }

      navLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
          var id = getLinkId(link);
          var target = document.getElementById(id);
          if (!target) return;

          // Handle the scroll ourselves instead of relying on the browser's
          // native #hash jump, which can be swallowed by the Squarespace
          // shell's own click/routing handlers on this page.
          event.preventDefault();
          event.stopPropagation();

          navigationRun += 1;
          var run = navigationRun;
          alignTarget(target, 'smooth');
          settleOnTarget(target, run);

          if (window.history && window.history.pushState) {
            window.history.pushState(null, '', '#' + id);
          } else {
            window.location.hash = id;
          }

          setActive(id);
        });
      });

      window.addEventListener('load', function () {
        var id = window.location.hash.slice(1);
        var target = id && document.getElementById(id);
        if (!target) return;

        navigationRun += 1;
        var run = navigationRun;
        alignTarget(target, 'auto');
        settleOnTarget(target, run);
      });
    })();
  </script>
