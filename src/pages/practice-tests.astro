---
import SquarespaceFooter from '../components/SquarespaceFooter.astro';
import SquarespaceHeader from '../components/SquarespaceHeader.astro';
import actLogo from '../assets/images/ACT_logo.webp';
import satLogo from '../assets/images/SAT_logo.png';
import { createShellConfig } from '../config/shell';
import { practiceTestsNode } from '../config/schema';
import SquarespaceShellLayout from '../layouts/SquarespaceShellLayout.astro';

const actAppUrl = 'https://app.hasantutoring.com/act-practice-test';
const satAppUrl = 'https://app.hasantutoring.com/sat-practice-test';
const config = createShellConfig({
  siteTitle: 'Free SAT & ACT Practice Tests | Hasan Tutoring',
  description: 'Take a free SAT or ACT practice test and get a detailed score report.',
  schema: [practiceTestsNode],
});

const directionContract = `
THESIS: A calm, direct test launcher that feels native to the Hasan Tutoring homepage; it refuses novelty that competes with the task.
OWN-WORLD: White and warm-paper bands, Garamond headings, light Proxima Nova copy, black rules, and precise red emphasis.
STORY: Understand the two testing routes, choose SAT or ACT, then begin with confidence.
FIRST VIEWPORT: A compact editorial introduction sits above two plainly labeled exam columns and a red assurance band.
FORM: Homepage-native editorial launcher, preserving the established visual world.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
`.trim();
---

<SquarespaceShellLayout config={config} directionContract={directionContract}>
  <div id="siteWrapper" class="clearfix site-wrapper practice-page">
    <SquarespaceHeader config={config} />

    <main id="page" class="practice-main" tabindex="-1">
      <section class="practice-intro" aria-labelledby="practice-title">
        <div class="practice-intro__inner">
          <div class="practice-intro__heading">
            <h1 id="practice-title"><span>Free</span> Practice Tests</h1>
            <ul class="practice-checklist" aria-label="Practice test benefits">
              <li>Test yourself at home</li>
              <li>Self-proctored</li>
              <li>Anytime, at your convenience</li>
            </ul>
            <p class="practice-intro__note">You don’t have to create an account. You don’t have to have a consultation (sales pitch) to see your score report. Take a practice test in the comfort of your own home, see where you’re at, and then, feel free to reach out if you want more information or want to talk through your options.</p>
            <a class="practice-intro__cta" href="#exam-picker">Get Started</a>
          </div>
          <div class="practice-intro__visual">
            <img
              src="/practice_test_splash.webp"
              width="1136"
              height="958"
              alt="Two sample Hasan Tutoring ACT practice test score reports"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <section id="exam-picker" class="exam-picker" aria-labelledby="exam-picker-title">
        <div class="exam-picker__inner">
          <div class="exam-picker__header">
            <h2 id="exam-picker-title">Choose your exam</h2>
            <div class="exam-picker__downloads" aria-label="Practice test downloads">
              <a href="/sat-practice-test-1-digital.pdf">
                <img src={satLogo.src} width="282" height="178" alt="" aria-hidden="true" />
                <span>SAT Practice Test</span>
              </a>
              <a href="/Practice%20Test%202.pdf">
                <img src={actLogo.src} width="225" height="225" alt="" aria-hidden="true" />
                <span>ACT Practice Test</span>
              </a>
            </div>
            <p>Understand your baseline with a practice test at no cost. See your options below.</p>
          </div>
          <div class="exam-cards">
            <article class="exam-card">
              <div class="exam-card__header">
                <h3>ACT Practice Test</h3>
                <a href={actAppUrl}>Get Started</a>
              </div>
              <ul>
                <li>Download/Print off the provided ACT.</li>
                <li>Self-proctor, 35 min. for English, 45 for Math, and 40 for Reading.</li>
                <li>Take each section in one sitting (10 min. break between Math and Reading).</li>
                <li>Or score one section at a time.</li>
              </ul>
            </article>

            <article class="exam-card">
              <div class="exam-card__header">
                <h3>SAT Practice Test</h3>
                <a href={satAppUrl}>Get Started</a>
              </div>
              <ul>
                <li>The SAT is now digital, so the best way to take a practice exam is on the Bluebook Exam app.</li>
                <li>On Bluebook, you’ll see which questions you got right and wrong and get a report with College Board’s Question Types.</li>
                <li>Here, you can take a paper version of the digital exam, enter your answers, and get a more detailed score report.</li>
                <li>Score both Reading and Writing and Math, or just one or the other.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

    </main>

    <SquarespaceFooter config={config} />
  </div>
</SquarespaceShellLayout>

<style>
  :global(#page.practice-main) {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .practice-page { overflow-x: clip; background: #fff; color: var(--color-text-dark); }
  .practice-main { width: 100%; min-width: 0; overflow: hidden; }
  .practice-page *, .practice-page *::before, .practice-page *::after { box-sizing: border-box; }

  .practice-intro {
    padding: clamp(3rem, 6vw, 5.75rem) var(--space-section-h);
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .practice-intro__inner,
  .exam-picker__inner {
    width: min(100%, 1280px);
    min-width: 0;
    margin: 0 auto;
  }

  .practice-intro__inner {
    width: min(100%, 1040px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .practice-intro h1 {
    max-width: 11ch;
    margin: 0;
    font: 700 clamp(2.15rem, 4vw, 3.5rem)/1.02 var(--font-serif);
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .practice-intro h1 span { color: var(--color-highlight-vivid); }

  .practice-checklist {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .practice-checklist li {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-height: 40px;
    padding: .55rem 1rem .55rem .72rem;
    color: #172231;
    background: #f0fff6;
    border: 1px solid #a9efc5;
    border-radius: 999px;
    font: 400 .96rem/1.25 var(--font-sans);
  }

  .practice-checklist li::before {
    content: '✓';
    display: inline-grid;
    flex: 0 0 1rem;
    width: 1rem;
    height: 1rem;
    place-items: center;
    color: #fff;
    background: #16a85b;
    border-radius: 50%;
    font: 700 .7rem/1 var(--font-sans);
  }

  .practice-intro__note {
    max-width: 52ch;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font: 300 1rem/1.65 var(--font-sans);
  }

  .practice-intro__cta {
    display: inline-flex;
    min-height: 46px;
    margin-top: 1.5rem;
    padding: .85rem 1.4rem;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--color-text-dark);
    border: 1px solid var(--color-text-dark);
    border-radius: 999px;
    font: 600 .8rem/1 var(--font-sans);
    letter-spacing: .04em;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .practice-intro__cta:hover {
    background: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson);
  }

  .practice-intro__cta:focus-visible {
    outline: 3px solid var(--color-accent-gold-light);
    outline-offset: 3px;
  }

  .practice-intro__visual img {
    display: block;
    width: 114%;
    height: auto;
    margin-inline: 0 auto;
  }

  .exam-picker {
    padding: clamp(3rem, 5vw, 4.75rem) var(--space-section-h);
    background: var(--color-surface);
    scroll-margin-top: 7rem;
  }

  .exam-picker__inner {
    width: min(100%, 1040px);
  }

  .exam-picker h2 {
    margin: 0;
    font: 700 clamp(2rem, 3vw, 2.8rem)/1.05 var(--font-serif);
    letter-spacing: -.02em;
  }

  .exam-picker__header {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
  }

  .exam-picker p {
    grid-column: 1 / -1;
    max-width: none;
    margin: 0;
    color: var(--color-muted);
    font: 300 1rem/1.65 var(--font-sans);
    white-space: nowrap;
  }

  .exam-picker__downloads {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1.5rem;
    align-items: center;
    justify-content: flex-end;
    padding-top: .45rem;
  }

  .exam-picker__downloads a {
    display: inline-flex;
    gap: .55rem;
    align-items: center;
    color: var(--color-text-dark);
    border-bottom: 1px solid currentColor;
    font: 600 .82rem/1.4 var(--font-sans);
    letter-spacing: .03em;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .exam-picker__downloads img {
    width: 2rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .exam-picker__downloads a:hover { color: var(--color-accent-crimson); }

  .exam-picker__downloads a:focus-visible {
    outline: 3px solid var(--color-accent-gold-light);
    outline-offset: 4px;
  }

  .exam-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .exam-card {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--color-border);
  }

  .exam-card h3 {
    margin: 0;
    font: 700 clamp(1.35rem, 2vw, 1.65rem)/1.12 var(--font-serif);
    letter-spacing: -.02em;
  }

  .exam-card__header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .exam-card__header a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 42px;
    padding: .7rem 1.1rem;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--color-text-dark);
    border: 1px solid var(--color-text-dark);
    border-radius: 999px;
    font: 600 .78rem/1 var(--font-sans);
    letter-spacing: .04em;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .exam-card__header a:hover {
    background: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson);
  }

  .exam-card__header a:focus-visible {
    outline: 3px solid var(--color-accent-gold-light);
    outline-offset: 3px;
  }

  .exam-card ul {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding-left: 1.2rem;
    color: var(--color-text-dark);
    font: 300 1rem/1.55 var(--font-sans);
  }

  .exam-card li { padding-left: .25rem; }
  .exam-card li::marker { color: var(--color-text-dark); }

  @media (max-width: 860px) {
    .practice-intro__inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .exam-picker__header,
    .exam-cards { grid-template-columns: 1fr; }
    .exam-picker p { white-space: normal; }
    .exam-picker__downloads { justify-content: flex-start; }

    .practice-intro h1 { max-width: 12ch; }
    .practice-intro__visual { margin-top: .75rem; }
    .practice-intro__visual img { width: 67%; margin-inline: auto; }

  }

  @media (max-width: 680px) {
    :global(#page.practice-main) { width: 100vw !important; max-width: 100vw !important; }

    .practice-intro,
    .exam-picker { width: 100vw; max-width: 100vw; }

    .practice-intro__inner,
    .exam-picker__inner { width: 100%; min-width: 0; }

    .practice-intro__inner { display: block; }

    .practice-intro { padding-top: 2.5rem; padding-bottom: 2.75rem; }
    .practice-checklist { align-items: flex-start; flex-direction: column; margin-top: 1.5rem; }

  }

  @media (prefers-reduced-motion: reduce) {
    .practice-intro__cta,
    .exam-picker__downloads a,
    .exam-card__header a { transition: none; }
  }
</style>
