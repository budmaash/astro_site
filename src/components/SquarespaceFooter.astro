---
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import '../styles/footer.css';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;
---

<footer class="ht-footer" id="footer-sections">
  <div class="ht-footer-spacer" aria-hidden="true"></div>

  <section class="ht-footer-main">
    <div class="ht-footer-inner">
      <div class="ht-footer-grid">
        {
          config.footer.columns.map((column) => (
            <div class="ht-footer-col">
              <h2 class="ht-footer-heading">{column.heading}</h2>
              <div class="ht-footer-body" set:html={column.html.join('\n')} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</footer>
