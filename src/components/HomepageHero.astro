---
import { getImage } from 'astro:assets';
import studyDesk from '../assets/images/hero/study-desk.png';
import practiceExams from '../assets/images/hero/practice-exams.png';
import scoreReportDetail from '../assets/images/hero/score-report-detail.png';
import logoSrc from '../assets/images/hero/hasan-tutoring-logo.png';

// Ported from the "Hero Animation" Claude Design composition (HeroScene.jsx).
// Three panels slide in from the right on a 4s cue each, with a slow Ken Burns
// push on the artwork underneath. The engine below runs the same authored-time
// model without React: one pure function of T drives every transform.
const SCENE_DURATION = 4;

const panels = [
  {
    key: 'Personalized',
    eyebrow: 'One-on-one tutoring',
    title: 'Individual, personalized test prep',
    image: await getImage({ src: studyDesk, width: 1120, format: 'webp', quality: 82 }),
    pos: '50% 50%',
    origin: 'center center',
    dark: true,
    logo: true,
    ken: [1.04, 1.13],
    panY: [1.2, -1.2],
  },
  {
    key: 'PracticeExams',
    eyebrow: 'Included, no cost',
    title: 'Free practice exams',
    image: await getImage({ src: practiceExams, width: 1400, format: 'webp', quality: 82 }),
    pos: '50% 52%',
    origin: 'center center',
    ken: [1.14, 1.24],
    panY: [0.6, -0.6],
  },
  {
    key: 'Patterns',
    eyebrow: 'Question-type mastery',
    title: 'Learn the question types and patterns',
    image: await getImage({ src: scoreReportDetail, width: 1400, format: 'webp', quality: 82 }),
    pos: '50% 100%',
    origin: 'center bottom',
    ken: [1.1, 1.18],
    panY: [0, -1.4],
  },
];

const logo = await getImage({ src: logoSrc, width: 750, format: 'webp', quality: 90 });

const scenes = panels.map((panel) => ({ key: panel.key, dur: SCENE_DURATION, ken: panel.ken, panY: panel.panY }));
---

<section class="ht-home-hero" aria-labelledby="ht-home-hero-title">
  <div class="ht-home-hero__grid">
    <div class="ht-home-hero__copy">
      <p class="ht-home-hero__eyebrow">ACT &amp; SAT tutoring · Kansas City + online</p>
      <h1 id="ht-home-hero-title" class="ht-home-hero__title">
        <span class="ht-home-hero__title-accent">Practical</span> methods to improve your ACT and SAT scores
      </h1>
      <p class="ht-home-hero__lede">
        Thanks for visiting! Here you can take free practice tests, find out about the testing process, and learn the methods I use to teach these exams.
      </p>

      <div class="ht-home-hero__actions" aria-label="Start here">
        <a class="ht-home-hero__action ht-home-hero__action--primary" href="/contact">
          <span class="ht-home-hero__action-copy">
            <span class="ht-home-hero__action-kicker">No-pressure conversation</span>
            <span class="ht-home-hero__action-label">Contact me</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M5 19 19 5M8 5h11v11"></path>
          </svg>
        </a>

        <a class="ht-home-hero__action ht-home-hero__action--secondary" href="/practice-tests">
          <span class="ht-home-hero__action-copy">
            <span class="ht-home-hero__action-kicker">No account needed</span>
            <span class="ht-home-hero__action-label">Free practice test</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M5 19 19 5M8 5h11v11"></path>
          </svg>
        </a>
      </div>
    </div>

    <figure class="ht-home-hero__visual">
      <div
        class="ht-hero-anim"
        data-hero-anim
        data-scenes={JSON.stringify(scenes)}
        data-loops="2"
        role="img"
        aria-label="Individual, personalized test prep; free practice exams; learn the question types and patterns"
      >
        {panels.map((panel, i) => (
          <div class="ht-hero-anim__panel" data-panel>
            <img
              class="ht-hero-anim__img"
              data-panel-img
              src={panel.image.src}
              width={panel.image.attributes.width}
              height={panel.image.attributes.height}
              alt=""
              aria-hidden="true"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              style={`object-position:${panel.pos};transform-origin:${panel.origin};`}
            />
            <div class:list={['ht-hero-anim__scrim', panel.dark && 'ht-hero-anim__scrim--dark']} />
            <div class="ht-hero-anim__text">
              <p class="ht-hero-anim__eyebrow" data-eyebrow>
                <span class="ht-hero-anim__rule" data-rule></span>
                <span>{panel.eyebrow}</span>
              </p>
              <p class="ht-hero-anim__title" data-title>{panel.title}</p>
            </div>
            {panel.logo && (
              <div class="ht-hero-anim__logo" data-logo>
                <img src={logo.src} width={logo.attributes.width} height={logo.attributes.height} alt="" aria-hidden="true" />
              </div>
            )}
          </div>
        ))}

        <div class="ht-hero-anim__dots" aria-hidden="true">
          {panels.map(() => (
            <span class="ht-hero-anim__dot" data-dot><span class="ht-hero-anim__dot-fill" data-dot-fill></span></span>
          ))}
        </div>

        <button class="ht-hero-anim__toggle" type="button" data-toggle hidden>
          <span class="ht-hero-anim__toggle-label" data-toggle-label>Pause</span>
          <span class="ht-hero-anim__toggle-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" data-icon-pause>
              <rect x="7" y="5" width="3.4" height="14" rx="1" />
              <rect x="13.6" y="5" width="3.4" height="14" rx="1" />
            </svg>
            <svg viewBox="0 0 24 24" fill="currentColor" data-icon-play hidden>
              <path d="M8 5.4v13.2a1 1 0 0 0 1.53.85l10.2-6.6a1 1 0 0 0 0-1.7L9.53 4.55A1 1 0 0 0 8 5.4Z" />
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-icon-replay hidden>
              <path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5" />
            </svg>
          </span>
        </button>
      </div>
    </figure>
  </div>
</section>

<style>
  .ht-home-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
  }

  .ht-home-hero__grid {
    display: grid;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
    min-height: min(760px, calc(100vh - var(--header-height, 82px)));
  }

  .ht-home-hero__copy {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding:
      clamp(4rem, 8vw, 7rem)
      clamp(2rem, 5vw, 5rem)
      clamp(4rem, 8vw, 7rem)
      max(var(--space-section-h), calc((100vw - var(--content-full)) / 2));
  }

  .ht-home-hero__eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-accent-crimson);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .ht-home-hero__title {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text-dark);
    font-family: var(--font-serif);
    font-size: clamp(3.15rem, 5.25vw, 5.5rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .ht-home-hero__title-accent {
    color: #ff0303;
  }

  .ht-home-hero__lede {
    max-width: 54ch;
    margin: 1.7rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.35vw, var(--text-md));
    font-weight: 300;
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }

  .ht-home-hero__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    width: 100%;
    max-width: 580px;
    margin-top: 2.25rem;
  }

  .ht-home-hero__action {
    display: flex;
    box-sizing: border-box;
    min-width: 0;
    min-height: 116px;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 1.15rem var(--space-5);
    border: 1px solid var(--color-text-dark);
    border-radius: 0;
    background: var(--color-surface);
    box-shadow: none;
    color: var(--color-text-dark);
    font-family: var(--font-sans);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .ht-home-hero__action:hover {
    box-shadow: var(--shadow-card-sm);
    transform: translateY(-2px);
  }

  /* Exactly one action reads as inverted at a time: "Contact me" by default,
     handing the emphasis to "Free practice test" while that one is hovered. */
  .ht-home-hero__action--primary,
  .ht-home-hero__action--secondary:hover {
    background: var(--color-text-dark);
    color: var(--color-surface);
  }

  .ht-home-hero__action--primary .ht-home-hero__action-kicker,
  .ht-home-hero__action--secondary:hover .ht-home-hero__action-kicker {
    color: rgba(255, 255, 255, 0.72);
  }

  .ht-home-hero__actions:has(.ht-home-hero__action--secondary:hover) .ht-home-hero__action--primary {
    background: var(--color-surface);
    color: var(--color-text-dark);
  }

  .ht-home-hero__actions:has(.ht-home-hero__action--secondary:hover)
    .ht-home-hero__action--primary
    .ht-home-hero__action-kicker {
    color: var(--color-muted);
  }

  .ht-home-hero__action--secondary:hover {
    border-color: var(--color-text-dark);
  }

  .ht-home-hero__action:active {
    box-shadow: none;
    transform: translateY(0);
  }

  .ht-home-hero__action:focus-visible {
    outline: 3px solid var(--color-accent-crimson);
    outline-offset: 3px;
  }

  .ht-home-hero__action-copy,
  .ht-home-hero__action-kicker,
  .ht-home-hero__action-label {
    display: block;
  }

  .ht-home-hero__action-copy {
    min-width: 0;
  }

  .ht-home-hero__action-kicker {
    margin-bottom: 0.3rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ht-home-hero__action-label {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .ht-home-hero__action svg {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }

  .ht-home-hero__action:hover svg {
    transform: translate(2px, -2px);
  }

  .ht-home-hero__visual {
    position: relative;
    min-width: 0;
    min-height: 560px;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  .ht-home-hero__visual::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(90deg, rgba(246, 243, 237, 0.35), transparent 30%);
    content: '';
    pointer-events: none;
  }

  .ht-hero-anim {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  .ht-hero-anim__panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #efeae1;
    transform: translate3d(104.2%, 0, 0);
    visibility: hidden;
    will-change: transform;
  }

  .ht-hero-anim__img {
    position: absolute;
    display: block;
    width: 100%;
    height: 100%;
    inset: 0;
    object-fit: cover;
    will-change: transform;
  }

  .ht-hero-anim__scrim {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 46%;
    background: linear-gradient(
      180deg,
      rgba(246, 243, 237, 0.97) 0%,
      rgba(246, 243, 237, 0.88) 46%,
      rgba(246, 243, 237, 0) 100%
    );
  }

  .ht-hero-anim__scrim--dark {
    background: linear-gradient(
      180deg,
      rgba(14, 13, 11, 0.78) 0%,
      rgba(14, 13, 11, 0.5) 38%,
      rgba(14, 13, 11, 0) 100%
    );
  }

  .ht-hero-anim__text {
    position: absolute;
    top: clamp(1.75rem, 4.4vw, 3.6rem);
    left: clamp(1.5rem, 4.4vw, 3.75rem);
    display: flex;
    max-width: min(73%, 44ch);
    flex-direction: column;
    gap: var(--space-3);
  }

  .ht-hero-anim__eyebrow {
    display: flex;
    align-items: center;
    margin: 0;
    gap: 0.875rem;
    color: var(--color-accent-crimson);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .ht-hero-anim__panel:has(.ht-hero-anim__scrim--dark) .ht-hero-anim__eyebrow {
    color: var(--color-surface);
  }

  .ht-hero-anim__rule {
    display: block;
    width: 0;
    height: 2px;
    flex: 0 0 auto;
    background: var(--color-accent-crimson);
  }

  .ht-hero-anim__title {
    margin: 0;
    color: var(--color-text-dark);
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .ht-hero-anim__panel:has(.ht-hero-anim__scrim--dark) .ht-hero-anim__title {
    color: var(--color-surface);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .ht-hero-anim__logo {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2.75rem);
    bottom: clamp(1.25rem, 2.8vw, 2.5rem);
    padding: 0.875rem 1.25rem;
    border: 1px solid #e2ddd3;
    border-radius: 12px;
    background: rgba(246, 243, 237, 0.94);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
    opacity: 0;
  }

  .ht-hero-anim__logo img {
    display: block;
    width: clamp(150px, 26vw, 250px);
    height: auto;
  }

  .ht-hero-anim__dots {
    position: absolute;
    z-index: 2;
    bottom: clamp(1.5rem, 3vw, 2.75rem);
    left: clamp(1.5rem, 4.4vw, 3.75rem);
    display: flex;
    gap: 10px;
  }

  .ht-hero-anim__dot {
    display: block;
    width: 22px;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
    transition: width var(--transition-fast);
  }

  .ht-hero-anim__dot[data-active] {
    width: 62px;
  }

  .ht-hero-anim__dot-fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent-crimson);
  }

  .ht-hero-anim__toggle {
    position: absolute;
    z-index: 3;
    padding: 0;
    border: 0;
    inset: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .ht-hero-anim__toggle:focus-visible {
    outline: 3px solid var(--color-accent-crimson);
    outline-offset: -3px;
  }

  .ht-hero-anim__toggle-label {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ht-hero-anim__toggle-badge {
    position: absolute;
    top: clamp(1.25rem, 2.8vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.75rem);
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.42);
    color: #fff;
    opacity: 0;
    transition:
      opacity var(--transition-fast),
      background-color var(--transition-fast);
  }

  .ht-hero-anim__toggle:hover .ht-hero-anim__toggle-badge,
  .ht-hero-anim__toggle:focus-visible .ht-hero-anim__toggle-badge,
  .ht-hero-anim__toggle[data-paused] .ht-hero-anim__toggle-badge {
    background: rgba(17, 17, 17, 0.62);
    opacity: 1;
  }

  .ht-hero-anim__toggle-badge svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .ht-hero-anim__toggle-badge svg[hidden] {
    display: none;
  }


  
  
  
  
  @media (max-width: 980px) {
    .ht-home-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }

    .ht-home-hero__copy {
      padding-right: max(var(--space-section-h), calc((100vw - var(--content-full)) / 2));
    }

    .ht-home-hero__title {
      max-width: 13ch;
    }

    .ht-home-hero__visual {
      min-height: 440px;
    }

    .ht-home-hero__visual::before {
      background: linear-gradient(180deg, rgba(246, 243, 237, 0.3), transparent 35%);
    }
  }

  @media (max-width: 700px) {
    .ht-home-hero__copy {
      padding: 3.75rem var(--space-section-h) 3rem;
    }

    .ht-home-hero__title {
      max-width: 11ch;
      font-size: clamp(2.75rem, 13vw, 4.5rem);
    }

    .ht-home-hero__actions {
      grid-template-columns: minmax(0, 1fr);
      width: auto;
      max-width: none;
    }

    .ht-home-hero__action {
      min-height: 94px;
    }

    .ht-home-hero__visual {
      min-height: 340px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .ht-home-hero__action,
    .ht-home-hero__action svg,
    .ht-hero-anim__dot,
    .ht-hero-anim__toggle-badge {
      transition: none;
    }
  }
</style>

<script>
  // Port of the Claude Design composition engine (animations-v3.jsx), reduced to
  // the pieces this scene uses: one authored-time axis T drives every transform.
  const easeInOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : (t - 1) * (2 * t - 2) * (2 * t - 2) + 1;
  const easeOutCubic = (t: number) => --t * t * t + 1;

  function ramp(t: number, start: number, end: number, from: number, to: number, ease: (n: number) => number) {
    if (t <= start) return from;
    if (t >= end) return to;
    return from + (to - from) * ease((t - start) / (end - start));
  }

  const slide = (t: number, start: number, end: number, from: number, to: number) =>
    ramp(t, start, end, from, to, easeInOutCubic);
  const enter = (t: number, start: number, from: number, to: number) =>
    ramp(t, start, start + 0.8, from, to, easeOutCubic);
  const lerp = (local: number, [a, b]: number[]) => a + (b - a) * Math.min(Math.max(local, 0), 1);

  const IN = 0.9;
  const OUT = 0.9;
  // Percent of stage width. The engine slid panels by W + 40 on a 960px stage, so
  // a narrow cream seam shows between slides — 1000/960 keeps that seam to scale.
  const OFFSCREEN = 104.2;

  type Scene = { key: string; dur: number; ken: number[]; panY: number[] };

  function setupHeroAnimation(root: HTMLElement) {
    const scenes: Scene[] = JSON.parse(root.dataset.scenes || '[]');
    const loops = Number(root.dataset.loops || '1');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    if (!scenes.length || panels.length !== scenes.length) return;

    let acc = 0;
    const cues = scenes.map((scene) => {
      const cue = acc;
      acc += scene.dur;
      return cue;
    });
    const total = acc;

    function frame(T: number) {
      const active = cues.reduce((best, cue, i) => (T >= cue - 0.4 ? i : best), 0);

      panels.forEach((panel, i) => {
        const scene = scenes[i];
        const cue = cues[i];
        const end = cue + scene.dur;
        const isFirst = i === 0;

        let x = slide(T, cue - IN, cue, OFFSCREEN, 0) + slide(T, end - OUT, end, 0, -OFFSCREEN);
        let visible = T >= cue - IN && T <= end;
        // The first panel wraps back in at the tail so a loop reads as continuous.
        if (isFirst && T > total - IN) {
          x = slide(T, total - IN, total, OFFSCREEN, 0);
          visible = true;
        }

        panel.style.visibility = visible ? 'visible' : 'hidden';
        if (!visible) return;

        panel.style.transform = `translate3d(${x}%, 0, 0)`;

        const local = (T - cue) / scene.dur;
        const img = panel.querySelector<HTMLElement>('[data-panel-img]');
        if (img) {
          img.style.transform = `scale(${lerp(local, scene.ken)}) translateY(${lerp(local, scene.panY)}%)`;
        }

        const eyebrow = panel.querySelector<HTMLElement>('[data-eyebrow]');
        if (eyebrow) eyebrow.style.opacity = String(enter(T, cue - 0.2, 0, 1));

        const rule = panel.querySelector<HTMLElement>('[data-rule]');
        if (rule) rule.style.width = `${enter(T, cue - 0.15, 0, 42)}px`;

        const title = panel.querySelector<HTMLElement>('[data-title]');
        if (title) {
          title.style.opacity = String(enter(T, cue - 0.1, 0, 1));
          title.style.transform = `translateY(${enter(T, cue - 0.1, 16, 0)}px)`;
        }

        const logo = panel.querySelector<HTMLElement>('[data-logo]');
        if (logo) {
          logo.style.opacity = String(enter(T, cue + 0.5, 0, 1));
          logo.style.transform = `translateY(${enter(T, cue + 0.5, 14, 0)}px)`;
        }
      });

      dots.forEach((dot, i) => {
        const on = i === active;
        dot.toggleAttribute('data-active', on);
        const progress = on
          ? Math.min(Math.max((T - cues[i]) / scenes[i].dur, 0), 1)
          : i < active
            ? 1
            : 0;
        const fill = dot.querySelector<HTMLElement>('[data-dot-fill]');
        if (fill) fill.style.width = `${progress * 100}%`;
      });
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const toggleLabel = root.querySelector<HTMLElement>('[data-toggle-label]');
    const iconPause = root.querySelector<HTMLElement>('[data-icon-pause]');
    const iconPlay = root.querySelector<HTMLElement>('[data-icon-play]');
    const iconReplay = root.querySelector<HTMLElement>('[data-icon-replay]');
    const runtime = total * loops;

    let rafId = 0;
    let elapsed = 0;
    let originAt = 0;
    // 'paused' is only ever set by the viewer; scrolling away suspends without
    // clearing it, so the hero resumes in whatever state they left it in.
    let state: 'playing' | 'paused' | 'ended' = 'playing';
    let onScreen = true;

    function syncToggle() {
      if (!toggle) return;
      const label = state === 'ended' ? 'Replay animation' : state === 'paused' ? 'Play animation' : 'Pause animation';
      toggle.setAttribute('aria-label', label);
      toggle.toggleAttribute('data-paused', state !== 'playing');
      if (toggleLabel) toggleLabel.textContent = label;
      if (iconPause) iconPause.hidden = state !== 'playing';
      if (iconPlay) iconPlay.hidden = state !== 'paused';
      if (iconReplay) iconReplay.hidden = state !== 'ended';
    }

    function suspend() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    }

    function tick(now: number) {
      elapsed = (now - originAt) / 1000;
      if (elapsed >= runtime) {
        elapsed = runtime;
        // Rest on the wrapped-in first panel, exactly where the composition ends.
        frame(total);
        rafId = 0;
        state = 'ended';
        syncToggle();
        return;
      }
      frame(elapsed % total);
      rafId = requestAnimationFrame(tick);
    }

    function run() {
      if (rafId || state !== 'playing' || !onScreen) return;
      originAt = performance.now() - elapsed * 1000;
      rafId = requestAnimationFrame(tick);
    }

    if (reduced.matches) {
      // Static: hold the opening panel, fully composed. No control to offer.
      frame(total);
      return;
    }

    frame(0);

    if (toggle) {
      toggle.hidden = false;
      syncToggle();
      toggle.addEventListener('click', () => {
        if (state === 'playing') {
          suspend();
          state = 'paused';
        } else {
          // Replaying from the end restarts the whole two-loop run.
          if (state === 'ended') elapsed = 0;
          state = 'playing';
          run();
        }
        syncToggle();
      });
    }

    // Only burn frames while the hero is actually on screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          onScreen = entry.isIntersecting;
          if (onScreen) run();
          else suspend();
        }
      },
      { threshold: 0.15 }
    );
    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-hero-anim]').forEach(setupHeroAnimation);
</script>
