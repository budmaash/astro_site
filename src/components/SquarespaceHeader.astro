---
import type { ShellConfig } from '../config/shell';
import { shellConfig } from '../config/shell';
import headerMarkup from '../fragments/header.html?raw';

const { config = shellConfig }: { config?: ShellConfig } = Astro.props;

const desktopNavMarkup = config.navigation
  .map(
    (item) => {
      if (item.children?.length) {
        const childMarkup = item.children
          .map(
            (child) => `
        <li class="ht-header-submenu__item">
          <a href="${child.href}" class="ht-header-submenu__link" data-animation-role="header-element">
            ${child.label}
          </a>
        </li>`,
          )
          .join('\n');

        return `
    <div class="header-nav-item header-nav-item--collection ht-header-dropdown">
      <a href="${item.href}" class="ht-header-dropdown__toggle" data-animation-role="header-element" aria-haspopup="true">
        ${item.label}
      </a>
      <ul class="ht-header-submenu">
${childMarkup}
      </ul>
    </div>`;
      }

      return `
    <div class="header-nav-item header-nav-item--collection${item.home ? ' header-nav-item--homepage' : ''}">
      <a href="${item.href}" data-animation-role="header-element">
        ${item.label}
      </a>
    </div>`;
    },
  )
  .join('\n');

const mobileNavMarkup = config.navigation
  .map(
    (item) => `
            <div class="container header-menu-nav-item header-menu-nav-item--collection${item.home ? ' header-menu-nav-item--homepage' : ''}">
              <a href="${item.href}">
                <div class="header-menu-nav-item-content">
                  ${item.label}
                </div>
              </a>
            </div>`,
  )
  .join('\n');

const replaceOnce = (input, searchValue, replaceValue) => {
  const index = input.indexOf(searchValue);
  if (index === -1) return input;
  return input.slice(0, index) + replaceValue + input.slice(index + searchValue.length);
};

const desktopNavRegex = /<nav class="header-nav-list">[\s\S]*?<\/nav>/;
const mobileNavRegex =
  /<div class="header-menu-nav-wrapper">[\s\S]*?(?=\s*<div class="user-accounts-link header-menu-nav-item)/;
const desktopLoginRegex =
  /\s*<div class="user-accounts-link header-nav-item header-nav-item--collection customerAccountLoginDesktop loaded"[\s\S]*?<\/div>\s*/;
const mobileLoginRegex =
  /\s*<div class="user-accounts-link header-menu-nav-item header-nav-item--collection customerAccountLoginMobile loaded"[\s\S]*?<\/div>\s*/;

let renderedHeaderMarkup = headerMarkup
  .replace(desktopNavRegex, `<nav class="header-nav-list">\n${desktopNavMarkup}\n                    </nav>`)
  .replace(desktopNavRegex, `<nav class="header-nav-list">\n${desktopNavMarkup}\n                    </nav>`)
  .replace(
    mobileNavRegex,
    `<div class="header-menu-nav-wrapper">\n${mobileNavMarkup}\n</div>`,
  )
  .replace(desktopLoginRegex, '\n')
  .replace(mobileLoginRegex, '\n')
  .replaceAll('https://www.hasantutoring.com/member-home', config.cta.href)
  .replaceAll('Member Home', config.cta.text)
  .replaceAll('https://www.hasantutoring.com/start-here-w/-banner#page', config.skipToContentUrl)
  .replaceAll('https://www.hasantutoring.com/start-here-w/-banner#', config.loginUrl);

renderedHeaderMarkup = renderedHeaderMarkup
  .replace(
    /\s*<div class="header-nav-item header-nav-item--collection">\s*<a href="https:\/\/www\.hasantutoring\.com\/blog"[\s\S]*?<\/a>\s*<\/div>/g,
    '',
  )
  .replace(
    /\s*<div class="container header-menu-nav-item header-menu-nav-item--collection">\s*<a href="https:\/\/www\.hasantutoring\.com\/blog">[\s\S]*?<\/a>\s*<\/div>/g,
    '',
  );

renderedHeaderMarkup = replaceOnce(
  renderedHeaderMarkup,
  '<a href="https://www.hasantutoring.com/" data-animation-role="header-element">',
  `<a href="${config.homeUrl}" data-animation-role="header-element">`,
);

renderedHeaderMarkup = replaceOnce(
  renderedHeaderMarkup,
  '<a href="https://www.hasantutoring.com/" data-animation-role="header-element">',
  `<a href="${config.homeUrl}" data-animation-role="header-element">`,
);
---
<Fragment set:html={renderedHeaderMarkup} />

<script is:inline>
  (() => {
    const header = document.getElementById('header');
    if (!header || header.dataset.mobileMenuReady === 'true') return;

    const menu = header.querySelector('[data-test="header-menu"]');
    const buttons = [...header.querySelectorAll('[data-test="header-burger"]')];
    if (!menu || buttons.length === 0) return;

    header.dataset.mobileMenuReady = 'true';
    menu.id ||= 'ht-mobile-menu';

    const setOpen = (open, { restoreFocus = false } = {}) => {
      document.body.classList.toggle('header--menu-open', open);

      buttons.forEach((button) => {
        button.classList.toggle('burger--active', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-controls', menu.id);

        const openTitle = button.querySelector('.js-header-burger-open-title');
        const closeTitle = button.querySelector('.js-header-burger-close-title');
        if (openTitle) openTitle.hidden = open;
        if (closeTitle) closeTitle.hidden = !open;
      });

      menu.setAttribute('aria-hidden', String(!open));
      if (restoreFocus) {
        const visibleButton = buttons.find((button) => button.offsetParent !== null);
        visibleButton?.focus();
      }
    };

    buttons.forEach((button) => {
      button.setAttribute('type', 'button');
      button.addEventListener('click', () => {
        setOpen(!document.body.classList.contains('header--menu-open'));
      });
    });

    menu.addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.body.classList.contains('header--menu-open')) {
        setOpen(false, { restoreFocus: true });
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 800px) and (pointer: fine)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });

    setOpen(false);
  })();
</script>

<style is:global>
  #header {
    position: sticky !important;
    top: 0;
    z-index: 100;
    background: #fff;
    box-shadow: 0 1px 0 rgba(20, 18, 15, 0.08),
                0 8px 24px rgba(20, 18, 15, 0.06);
  }

  #header .header-background,
  #header .header-menu-bg {
    background: #fff !important;
  }

  #header .header-announcement-bar-wrapper,
  #header .header-inner,
  #header .header-display-desktop,
  #header .header-display-mobile {
    background-color: #fff !important;
    opacity: 1 !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
  }

  #header .header-announcement-bar-wrapper {
    padding-top: clamp(0.55rem, 1vw, 0.8rem) !important;
    padding-bottom: clamp(0.55rem, 1vw, 0.8rem) !important;
  }

  .ht-header-dropdown {
    position: relative;
  }

  .ht-header-dropdown::after {
    content: '';
    height: 0.75rem;
    left: 0;
    position: absolute;
    right: 0;
    top: 100%;
  }

  .ht-header-dropdown__toggle {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    gap: 0.35em;
    letter-spacing: inherit;
    line-height: inherit;
    padding: 0;
    text-transform: inherit;
  }

  .ht-header-dropdown__toggle::after {
    border-left: 1px solid currentColor;
    border-top: 1px solid currentColor;
    content: '';
    display: inline-block;
    height: 0.42em;
    margin-top: -0.12em;
    transform: rotate(225deg);
    width: 0.42em;
  }

  .ht-header-submenu {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    left: 0;
    list-style: disc;
    list-style-position: outside;
    margin: 0;
    min-width: 8rem;
    opacity: 0;
    padding: 0.65rem 1rem 0.65rem 2rem;
    pointer-events: none;
    position: absolute;
    text-align: left;
    top: 100%;
    transition: opacity 160ms ease;
    visibility: hidden;
    z-index: 30;
  }

  .ht-header-submenu__item {
    margin: 0;
  }

  .ht-header-dropdown:hover .ht-header-submenu,
  .ht-header-dropdown:focus-within .ht-header-submenu {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .ht-header-submenu__link {
    color: inherit;
    display: block;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    padding: 0.35rem 1rem;
    text-align: left;
    text-decoration: none;
    text-transform: inherit;
    white-space: nowrap;
  }

  .ht-header-mobile-group {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ht-header-mobile-group__label {
    opacity: 1;
  }

  .ht-header-mobile-group__link {
    color: inherit;
    text-decoration: none;
  }

  .ht-header-mobile-submenu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: disc;
    list-style-position: outside;
    margin: 0;
    padding-left: 1rem;
  }

  .ht-header-mobile-submenu__item {
    margin: 0;
  }

  .ht-header-mobile-submenu__link {
    color: inherit;
    display: block;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-decoration: none;
    text-transform: inherit;
  }
</style>
