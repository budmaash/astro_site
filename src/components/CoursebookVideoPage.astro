---
import { vimeoEmbedUrl, type VideoLesson } from '../data/videoLessons';

interface Props {
  videos: VideoLesson[];
  // Sidebar heading, e.g. 'Contents · SAT Math'.
  contentsLabel: string;
  // The hub page (e.g. /sat_videos) that lists every video.
  // questionsLabel heads the question list in the sidebar. With groupLabels,
  // each group (e.g. 'English', 'Math') gets its own collapsible list instead.
  // With sectionHeadings, the hub page gives each group its own section too.
  hub: {
    name: string;
    path: string;
    eyebrow?: string;
    intro: string;
    questionsLabel: string;
    groupLabels?: Record<string, string>;
    sectionHeadings?: Record<string, string>;
    // Shown above each video, e.g. a link to /act-tutoring.
    tutoringLink?: { href: string; text: string };
  };
  // The video this page shows; omitted on the hub page.
  current?: VideoLesson;
  // Show the Lessons group in the sidebar and on the hub. Off for ACT and SAT.
  showLessons?: boolean;
}

const { videos: allVideos, contentsLabel, hub, current, showLessons = true } = Astro.props;

// Sidebar order is also the previous/next order: lessons, then question explanations.
const lessonVideos = allVideos.filter((video) => video.section === 'lesson');
const questionVideos = allVideos.filter((video) => video.section === 'question');
const videoLessons = [...lessonVideos, ...questionVideos];
const currentIndex = current ? videoLessons.findIndex((video) => video.id === current.id) : -1;
const previous = currentIndex > 0 ? videoLessons[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? videoLessons[currentIndex + 1] : undefined;
const hasNotes = Boolean(current?.annotationTitle);

// Question explanations are listed under sub-headings such as 'Module 1'.
const questionGroups = [...new Set(questionVideos.map((video) => video.group ?? ''))].map((name) => {
  const videos = questionVideos.filter((video) => (video.group ?? '') === name);
  return { name, test: videos[0]?.test, videos };
});

// Sidebar lists: one per group when the hub names them, otherwise a single
// list with each group as a sub-heading.
const groupLabels = hub.groupLabels;
const questionSections = groupLabels
  ? questionGroups.map((group) => ({ label: groupLabels[group.name] ?? group.name, groups: [group], split: true }))
  : [{ label: hub.questionsLabel, groups: questionGroups, split: false }];

// Hub page sections: one per group when the hub names them, otherwise a
// single 'Question explanations' section.
const sectionHeadings = hub.sectionHeadings;
const hubSections = sectionHeadings
  ? questionGroups.map((group, index) => ({
      id: `hub-questions-title-${index}`,
      heading: sectionHeadings[group.name] ?? group.name,
      note: undefined,
      groups: [group],
    }))
  : [{
      id: 'hub-questions-title',
      heading: 'Question explanations',
      note: 'One short video for each question, in test order.',
      groups: questionGroups,
    }];

// Old links used /sat_videos/#<id>; the hub forwards those to the video's own page.
const hashRedirects = current ? null : Object.fromEntries(videoLessons.map((video) => [video.id, video.path]));
---

<div class="coursebook" data-od-id="coursebook-page">
  <nav class="chapter-menu" id="coursebook-menu" aria-label="Video chapters" data-od-id="coursebook-sidebar">
    <button class="menu-close" type="button" aria-label="Close contents">×</button>
    <p class="contents-label"><a href={hub.path}>{contentsLabel}</a></p>

    {showLessons && (
    <div class="chapter-group">
      <p class="group-label" id="coursebook-group-lesson">Lessons</p>
      {lessonVideos.length ? (
        <ol class="chapter-list" aria-labelledby="coursebook-group-lesson">
          {lessonVideos.map((video, position) => (
            <li>
              <a class="chapter-button" href={video.path} aria-current={video.id === current?.id ? 'page' : undefined}>
                <span class="chapter-number">Lesson {String(position + 1).padStart(2, '0')}</span>
                <strong class="chapter-name">{video.title}</strong>
                <small class="chapter-type">Video lesson · {video.duration}</small>
              </a>
            </li>
          ))}
        </ol>
      ) : <p class="group-empty">No lessons yet.</p>}
    </div>
    )}

    {questionSections.map(({ label, groups, split }, sectionIndex) => {
      const count = groups.reduce((total, group) => total + group.videos.length, 0);
      const holdsCurrent = groups.some((group) => group.videos.some((video) => video.id === current?.id));
      // A split list opens on its own pages and on the hub; a single list
      // opens whenever there is no Lessons group above it.
      const open = split ? !current || holdsCurrent : !showLessons || current?.section === 'question';
      const summaryId = `coursebook-group-question-${sectionIndex}`;
      return count > 0 && (
      <details class="chapter-group question-group" open={open}>
        <summary class="group-label group-toggle" id={summaryId}>
          <span>{label}</span>
          <span class="group-count">{count}</span>
        </summary>
        {groups.map(({ name, videos }, groupIndex) => (
          <div class="question-subgroup">
            {!split && name && <p class="subgroup-label" id={`${summaryId}-${groupIndex}`}>{name}</p>}
            <ol class="chapter-list" aria-labelledby={!split && name ? `${summaryId}-${groupIndex}` : summaryId}>
              {videos.map((video) => (
                <li>
                  <a
                    class="chapter-button chapter-button--compact"
                    href={video.path}
                    aria-current={video.id === current?.id ? 'page' : undefined}
                    aria-label={video.title}
                  >
                    <strong class="chapter-name">{video.shortTitle ?? video.title}</strong>
                    <small class="chapter-duration">{video.duration}</small>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </details>
      );
    })}
  </nav>

  <div class="menu-scrim" aria-hidden="true"></div>

  <section class="reading-pane">
    <header class="mobile-toolbar">
      <button class="menu-open" type="button" aria-controls="coursebook-menu" aria-expanded="false">
        <span aria-hidden="true">☰</span><span>Lesson menu</span>
      </button>
    </header>

    <main class="article" id="page" tabindex="-1" data-od-id="coursebook-main">
      {current ? (
        <>
          <header class="article-heading">
            <a class="resources-link" href="/resources">← Back to resources</a>
            <p class="category">{current.eyebrow}</p>
            <h1 data-od-id="video-title">{current.title}</h1>
          </header>

          <div class="video-row">
            <div class="video-wrap">
              {hub.tutoringLink && (
                <p class="tutoring-link"><a href={hub.tutoringLink.href}>{hub.tutoringLink.text}</a></p>
              )}
              <div class="video" data-od-id="vimeo-player">
                <iframe
                  src={vimeoEmbedUrl(current)}
                  title={`${current.title} video`}
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <nav class="video-nav" aria-label="Video navigation" data-od-id="lesson-pager">
                {previous ? (
                  <a class="video-nav__link" href={previous.path} rel="prev" aria-label={`Previous: ${previous.title}`}>
                    <span aria-hidden="true">←</span> Previous
                  </a>
                ) : (
                  <span class="video-nav__link" aria-disabled="true"><span aria-hidden="true">←</span> Previous</span>
                )}
                {next ? (
                  <a class="video-nav__link" href={next.path} rel="next" aria-label={`Next: ${next.title}`}>
                    Next <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="video-nav__link" aria-disabled="true">Next <span aria-hidden="true">→</span></span>
                )}
              </nav>

              <aside class="references" aria-labelledby="coursebook-links-title" data-od-id="relevant-links">
                <h2 id="coursebook-links-title">Relevant links</h2>
                <ul>
                  {current.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                </ul>
              </aside>
            </div>
          </div>

          {hasNotes && (
            <div class="lesson-details">
              <section class="annotation" aria-labelledby="coursebook-annotation-title" data-od-id="lesson-annotation">
                <h2 id="coursebook-annotation-title">{current.annotationTitle}</h2>
                <p>{current.annotationCopy}</p>
                {current.callout && <div class="callout">{current.callout}</div>}
              </section>
            </div>
          )}

        </>
      ) : (
        <>
          <header class="article-heading">
            <a class="resources-link" href="/resources">← Return to resources</a>
            {hub.eyebrow && <p class="category">{hub.eyebrow}</p>}
            <h1 data-od-id="video-title">{hub.name}</h1>
            <p class="lede">{hub.intro}</p>
          </header>

          {showLessons && (
          <section class="hub-section" aria-labelledby="hub-lessons-title">
            <h2 id="hub-lessons-title">Lessons</h2>
            {lessonVideos.length ? (
              <ol class="hub-lessons">
                {lessonVideos.map((video) => (
                  <li><a href={video.path}><strong>{video.title}</strong><small>{video.duration}</small></a></li>
                ))}
              </ol>
            ) : <p class="hub-empty">No lessons yet.</p>}
          </section>
          )}

          {questionVideos.length > 0 && hubSections.map(({ id, heading, note, groups }) => (
            <section class="hub-section" aria-labelledby={id}>
              <h2 id={id}>{heading}</h2>
              {note && <p>{note}</p>}
              {groups.map(({ name, test, videos }) => (
                <div class="hub-group">
                  <h3>{[test, name].filter(Boolean).join(' · ')}</h3>
                  <ol class="hub-grid">
                    {videos.map((video) => (
                      <li><a href={video.path} aria-label={`${video.title} (${video.duration})`}><strong>{video.shortTitle ?? video.title}</strong><small>{video.duration}</small></a></li>
                    ))}
                  </ol>
                </div>
              ))}
            </section>
          ))}
        </>
      )}
    </main>
  </section>
</div>

{hashRedirects && (
  <script
    id="coursebook-hash-redirects"
    type="application/json"
    is:inline
    set:html={JSON.stringify(hashRedirects).replace(/</g, String.fromCharCode(92) + 'u003c')}
  ></script>
)}

<script is:inline>
  (() => {
    const root = document.querySelector('[data-od-id="coursebook-page"]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    // Forward old /sat_videos/#<id> links to the video's own page.
    const redirects = document.getElementById('coursebook-hash-redirects');
    if (redirects && window.location.hash) {
      const target = JSON.parse(redirects.textContent || '{}')[window.location.hash.slice(1)];
      if (target) {
        window.location.replace(target);
        return;
      }
    }

    const query = (selector) => root.querySelector(selector);
    const menu = query('#coursebook-menu');
    const menuButton = query('.menu-open');
    const scrim = query('.menu-scrim');
    const menuMedia = window.matchMedia('(max-width: 980px)');

    // Keep the current video visible in a long sidebar list.
    const currentLink = menu.querySelector('[aria-current="page"]');
    if (currentLink) menu.scrollTop = currentLink.offsetTop - menu.clientHeight / 2;

    function syncMenuAccessibility() {
      const closed = menuMedia.matches && !menu.classList.contains('is-open');
      menu.inert = closed;
      menu.setAttribute('aria-hidden', String(closed));
    }

    function closeMenu({ restoreFocus = false } = {}) {
      menu.classList.remove('is-open');
      scrim?.classList.remove('is-visible');
      menuButton?.setAttribute('aria-expanded', 'false');
      syncMenuAccessibility();
      if (restoreFocus) menuButton?.focus();
    }

    menuButton?.addEventListener('click', () => {
      const open = !menu.classList.contains('is-open');
      menu.classList.toggle('is-open', open);
      scrim?.classList.toggle('is-visible', open);
      menuButton.setAttribute('aria-expanded', String(open));
      syncMenuAccessibility();
      if (open) query('.menu-close')?.focus();
    });
    query('.menu-close')?.addEventListener('click', () => closeMenu({ restoreFocus: true }));
    scrim?.addEventListener('click', () => closeMenu({ restoreFocus: true }));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) closeMenu({ restoreFocus: true });
    });
    menuMedia.addEventListener('change', () => closeMenu());
    syncMenuAccessibility();
  })();
</script>

<style>
  .coursebook {
    --cb-page: var(--color-surface, oklch(1 0 89.88));
    --cb-hover: var(--color-bg, oklch(.9648 .0086 84.57));
    --cb-fg: var(--color-text, oklch(.1776 0 89.88));
    --cb-muted: var(--color-muted, oklch(.4698 .0142 79.72));
    --cb-border: var(--color-border, oklch(.8987 .0145 84.59));
    --cb-accent: var(--color-accent-crimson, oklch(.4158 .1484 26.59));
    --cb-gold: var(--color-accent-gold, oklch(.73 .075 83));
    --cb-serif: var(--font-serif, adobe-garamond-pro, Georgia, "Times New Roman", serif);
    --cb-sans: var(--font-sans, proxima-nova, "Helvetica Neue", Arial, sans-serif);
    --cb-ease: cubic-bezier(.23, 1, .32, 1);
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    min-height: 100vh;
    background: var(--cb-page);
    color: var(--cb-fg);
    font: 400 16px/1.6 var(--cb-sans);
  }

  .coursebook, .coursebook * { box-sizing: border-box; }
  .coursebook button, .coursebook a { font: inherit; }
  .coursebook a { color: inherit; }
  .coursebook :focus-visible { outline: 3px solid var(--cb-accent); outline-offset: 3px; }

  .chapter-menu {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: auto;
    border-right: 1px solid var(--cb-fg);
    background: var(--cb-page);
  }

  .contents-label a { text-decoration: none; }
  .contents-label a:hover { color: var(--cb-accent); }
  .contents-label {
    margin: 0;
    padding: 28px 24px 10px;
    color: var(--cb-muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .chapter-group + .chapter-group { margin-top: 18px; }
  .group-label {
    margin: 0;
    padding: 12px 24px;
    color: var(--cb-fg);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .group-toggle {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--cb-border);
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms var(--cb-ease);
  }
  .group-toggle::-webkit-details-marker { display: none; }
  .group-toggle:hover { background: var(--cb-hover); }
  .group-toggle::after { margin-left: 4px; content: "+"; font-size: 16px; font-weight: 400; line-height: 1; }
  .question-group[open] .group-toggle::after { content: "−"; }
  .group-count { margin-left: auto; color: var(--cb-muted); font-weight: 500; letter-spacing: .04em; }
  .question-group:not([open]) .group-toggle { border-bottom: 1px solid var(--cb-border); }
  /* Stacked question lists sit flush, with a single divider between them. */
  .question-group + .question-group { margin-top: 0; }
  .question-group:not([open]) + .question-group .group-toggle { border-top: 0; }
  .chapter-list { margin: 0; padding: 0; list-style: none; }
  .group-empty { margin: 0; padding: 0 24px 6px; color: var(--cb-muted); font-size: 13px; }
  .subgroup-label {
    margin: 0;
    padding: 14px 24px 8px;
    color: var(--cb-muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .chapter-button.chapter-button--compact {
    display: flex;
    min-height: 44px;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 24px;
  }
  .chapter-button--compact .chapter-name { font-size: 16px; }
  .chapter-duration { color: var(--cb-muted); font-size: 11px; font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .chapter-button--compact[aria-current="page"] .chapter-name::after { display: none; }
  .chapter-button--compact[aria-current="page"] { box-shadow: inset 3px 0 0 var(--cb-accent); }
  .chapter-button {
    display: block;
    width: 100%;
    padding: 18px 24px;
    border: 0;
    border-top: 1px solid var(--cb-border);
    background: transparent;
    color: var(--cb-muted);
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition: background-color 200ms var(--cb-ease), color 200ms var(--cb-ease);
  }

  .chapter-list li:last-child .chapter-button { border-bottom: 1px solid var(--cb-border); }
  .chapter-button:hover, .chapter-button[aria-current="page"] { background: var(--cb-hover); color: var(--cb-fg); }
  .chapter-button[aria-current="page"] .chapter-name::after { float: right; color: var(--cb-accent); content: "●"; font-size: 8px; }
  .chapter-number { display: block; margin-bottom: 8px; font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .chapter-name { display: block; font: 400 18px/1.08 var(--cb-serif); }
  .chapter-type { display: block; margin-top: 6px; font-size: 10px; font-weight: 400; letter-spacing: .08em; text-transform: uppercase; }

  .menu-close { display: none; }
  .menu-scrim { display: none; }
  .reading-pane { min-width: 0; background: var(--cb-page); }
  .mobile-toolbar { display: none; }

  .article {
    width: min(calc(100% - 28px), 1380px);
    margin-left: 28px;
    padding: 24px 0 80px;
  }

  .article-heading { margin: 0 0 44px; text-align: left; }
  .resources-link {
    display: flex;
    width: max-content;
    min-height: 44px;
    align-items: center;
    margin-bottom: 24px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .09em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .resources-link:hover { color: var(--cb-accent); }
  /* Same size as the resources link above the title, as rendered (16px). */
  .tutoring-link { margin: 0 0 12px; font-size: 16px; text-align: right; }
  .tutoring-link a { color: var(--cb-accent); text-decoration: underline; text-decoration-color: currentColor; text-underline-offset: 4px; }
  .tutoring-link a:hover { text-decoration-thickness: 2px; }
  .category { margin: 0 0 14px; color: var(--cb-accent); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .article-heading h1 {
    max-width: 900px;
    margin: 0;
    font: 400 clamp(48px, 5vw, 60px)/1 var(--cb-serif);
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .lede { max-width: 62ch; margin: 18px 0 0; color: var(--cb-muted); font-size: 17px; }

  .video-row { padding-bottom: 48px; }
  .video-wrap { max-width: 1032px; }
  .video-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .video-nav__link { display: inline-flex; align-items: center; gap: 8px; padding: 6px 0; color: var(--cb-fg); font-size: 14px; font-weight: 500; text-decoration: none; transition: color 150ms var(--cb-ease); }
  a.video-nav__link:hover { color: var(--cb-accent); }
  .video-nav__link[aria-disabled="true"] { opacity: .35; }
  .video { position: relative; overflow: hidden; aspect-ratio: 16/9; border: 1px solid var(--cb-fg); background: var(--cb-fg); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .lesson-details { padding: 0 0 48px; }
  .annotation[hidden] { display: none; }
  .annotation h2 { margin: 0 0 16px; font: 400 30px/1.05 var(--cb-serif); letter-spacing: -.01em; }
  .annotation p { max-width: 58ch; margin: 0; color: var(--cb-muted); }
  .callout { margin-top: 26px; padding: 22px 0; border-block: 1px solid var(--cb-gold); font: 400 21px/1.3 var(--cb-serif); }
  .references { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--cb-border); }
  .references h2 { margin: 0; color: var(--cb-accent); font-family: var(--cb-sans); font-size: 12px; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; }
  .references ul { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0; padding: 0; list-style: none; }
  .references a { font-size: 16px; text-decoration: underline; text-decoration-color: var(--cb-border); text-underline-offset: 4px; }
  .references a:hover { color: var(--cb-accent); text-decoration-color: currentColor; }

  .hub-section { padding: 40px 0 8px; border-top: 1px solid var(--cb-fg); }
  .hub-section + .hub-section { margin-top: 32px; }
  .hub-section h2 { margin: 0 0 6px; font: 400 34px/1.05 var(--cb-serif); letter-spacing: -.01em; }
  .hub-section > p { margin: 0 0 22px; color: var(--cb-muted); }
  .hub-section h2 + .hub-group { margin-top: 22px; }
  .hub-group + .hub-group { margin-top: 30px; }
  .hub-group h3 { margin: 0 0 12px; color: var(--cb-accent); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1px; margin: 0; padding: 0; border: 1px solid var(--cb-border); background: var(--cb-border); list-style: none; }
  .hub-grid a { display: flex; min-height: 64px; align-items: baseline; justify-content: space-between; gap: 10px; padding: 14px 16px; background: var(--cb-page); text-decoration: none; transition: background-color 200ms var(--cb-ease), color 200ms var(--cb-ease); }
  .hub-grid a:hover { background: var(--cb-hover); color: var(--cb-accent); }
  .hub-grid strong { font: 400 18px/1.1 var(--cb-serif); }
  .hub-grid small { color: var(--cb-muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .hub-lessons { margin: 0; padding: 0; list-style: none; }
  .hub-lessons a { display: flex; min-height: 64px; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--cb-border); text-decoration: none; }
  .hub-lessons li:last-child a { border-bottom: 1px solid var(--cb-border); }
  .hub-lessons a:hover { color: var(--cb-accent); }
  .hub-lessons strong { font: 400 21px/1.15 var(--cb-serif); }
  .hub-lessons small { color: var(--cb-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .hub-empty { color: var(--cb-muted); }

  @media (max-width: 980px) {
    .coursebook { display: block; min-height: 0; }
    .chapter-menu {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      width: min(86vw, 300px);
      height: 100vh;
      transform: translateX(-102%);
      transition: transform 200ms var(--cb-ease);
    }
    .chapter-menu.is-open { transform: translateX(0); }
    .menu-close { position: absolute; top: 16px; right: 14px; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--cb-border); background: var(--cb-page); color: var(--cb-fg); cursor: pointer; }
    .contents-label { padding-right: 72px; }
